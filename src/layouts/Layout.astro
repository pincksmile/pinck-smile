---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import CartDrawer from "@/components/cart-drawer.astro";
import "@fontsource-variable/inter/index.css";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    authors?: string[];
    section?: string;
    tags?: string[];
  };
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://pinck-smile.netlify.app";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();

const defaultDescription = "PINCK SMILE - Female Intimate Wellness, Thoughtfully. Perawatan kesehatan intim wanita dengan formula pH seimbang, bahan body-safe medis, edukasi literasi tubuh, serta jaminan kemasan privat (discreet) 100%.";

const { 
  title, 
  description = defaultDescription,
  image = "/opengraph.jpg",
  article,
  jsonLd
} = Astro.props;

const makeTitle = title
  ? (title.includes("PINCK SMILE") ? title : `${title} | PINCK SMILE`)
  : "PINCK SMILE - Female Intimate Wellness Indonesia";

const ogImageUrl = image.startsWith("http") ? image : new URL(image, siteUrl).toString();

// Default Organization & Website Schema
const defaultSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "PINCK SMILE",
    "alternateName": [
      "Pink Smile",
      "PinkSmile",
      "Pinck Smile",
      "PinckSmile",
      "PINCK SMILE Indonesia",
      "Pink Smile Official",
      "Pink Smile Intimate Care",
      "Pink Smile Wellness"
    ],
    "url": siteUrl,
    "logo": `${siteUrl}/favicon.svg`,
    "description": "PINCK SMILE (dikenal juga sebagai Pink Smile) - Female Intimate Wellness, Thoughtfully. Perawatan kesehatan intim wanita berbasis sains, pH seimbang, dan 100% kemasan privat.",
    "sameAs": [
      "https://instagram.com/pincksmile",
      "https://tiktok.com/@pincksmile",
      "https://s.shopee.co.id/9zx2C9Pfba",
      "https://share.google/nJK2B7iDNKitHambl",
      "https://tokopedia.com/pincksmile"
    ],
    "knowsAbout": [
      "Female Intimate Wellness",
      "Pembersih Kewanitaan pH Seimbang",
      "Perawatan Daerah Kewanitaan",
      "Kesehatan Reproduksi Wanita",
      "Discreet Packaging Indonesia"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+62-889-8087-4055",
      "contactType": "Customer Support & Concierge",
      "email": "pincksmile@gmail.com",
      "availableLanguage": ["Indonesian", "English"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "url": siteUrl,
    "name": "PINCK SMILE",
    "alternateName": ["Pink Smile", "PinkSmile", "Pinck Smile", "PinckSmile", "PINCK SMILE Store"],
    "description": "PINCK SMILE (Pink Smile) - Female Intimate Wellness, Thoughtfully. Brand perawatan intim wanita terpercaya di Indonesia.",
    "publisher": {
      "@id": `${siteUrl}/#organization`
    },
    "inLanguage": "id-ID"
  }
];

const structuredData = jsonLd 
  ? (Array.isArray(jsonLd) ? [...defaultSchemas, ...jsonLd] : [...defaultSchemas, jsonLd])
  : defaultSchemas;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme & App Metadata -->
    <meta name="theme-color" content="#FFE5F7" />
    <meta name="msapplication-TileColor" content="#FFE5F7" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="PINCK SMILE" />

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="googlecb55c40e4a440bf0" />

    <!-- SEO Search Engine Directives & Comprehensive Brand Keywords -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="keywords" content="Pink Smile, Pinck Smile, PinkSmile, PinckSmile, pinck-smile, Pink Smile Indonesia, Pink Smile Official, sabun pembersih kewanitaan pink smile, intimate wash pink smile, soothing mist pink smile, aura intimate device pink smile, female intimate wellness, perawatan intim wanita, kesehatan kewanitaan, pembersih kewanitaan pH seimbang, intimate wash alami, intimate mist, discreet shipping indonesia, body literacy, edukasi kesehatan intim wanita, BPOM pembersih kewanitaan" />
    <meta name="author" content="PINCK SMILE Team" />
    <meta name="publisher" content="PINCK SMILE" />
    <meta name="language" content="Indonesian" />
    <meta name="geo.region" content="ID" />
    <meta name="geo.country" content="ID" />
    <meta name="geo.placename" content="Jakarta, Indonesia" />
    <meta name="target" content="all" />
    <meta name="rating" content="general" />
    
    <!-- Google Fonts for Editorial & Refined Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <SEO
      title={makeTitle}
      description={description}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: article ? "article" : "website",
          title: makeTitle,
          image: ogImageUrl,
        },
        optional: {
          siteName: "PINCK SMILE",
          description: description,
          locale: "id_ID",
        },
        image: {
          alt: makeTitle,
          width: 1200,
          height: 630,
        },
        article: article,
      }}
      twitter={{
        card: "summary_large_image",
        site: "@pincksmile",
        creator: "@pincksmile",
        title: makeTitle,
        description: description,
        image: ogImageUrl,
        imageAlt: makeTitle,
      }}
    />

    <!-- Dedicated Social Media & Messenger Meta Directives (WhatsApp, Telegram, Facebook, LinkedIn) -->
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="thumbnail" content={ogImageUrl} />
    <link rel="image_src" href={ogImageUrl} />

    <!-- Structured Data / JSON-LD for Google Rich Results -->
    {
      structuredData.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col bg-white text-[#29242A] selection:bg-[#FFE5F7] selection:text-[#29242A]">
    <Navbar />
    <main class="flex-grow" id="main-content">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <style is:global>
      /* Image Rendering Performance */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
