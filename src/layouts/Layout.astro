---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import CartDrawer from "@/components/cart-drawer.astro";
import "@fontsource-variable/inter/index.css";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    authors?: string[];
    section?: string;
    tags?: string[];
  };
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://pincksmile.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();

const defaultDescription = "PINCK SMILE - Female Intimate Wellness, Thoughtfully. Perawatan kesehatan intim wanita dengan formula pH seimbang, bahan body-safe medis, edukasi literasi tubuh, serta jaminan kemasan privat (discreet) 100%.";

const { 
  title, 
  description = defaultDescription,
  image = "/opengraph.jpg",
  article,
  jsonLd
} = Astro.props;

const makeTitle = title
  ? `${title} | PINCK SMILE`
  : "PINCK SMILE | Female Intimate Wellness, Thoughtfully";

const ogImageUrl = image.startsWith("http") ? image : new URL(image, siteUrl).toString();

// Default Organization & Website Schema
const defaultSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "PINCK SMILE",
    "alternateName": ["Pinck Smile", "PinckSmile Intimate Wellness"],
    "url": siteUrl,
    "logo": `${siteUrl}/favicon.svg`,
    "description": "Female Intimate Wellness, Thoughtfully. Perawatan kesehatan intim wanita berbasis sains, pH seimbang, dan 100% kemasan privat.",
    "sameAs": [
      "https://instagram.com/pincksmile",
      "https://tiktok.com/@pincksmile",
      "https://shopee.co.id/pincksmile",
      "https://tokopedia.com/pincksmile"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+62-889-8087-4055",
      "contactType": "Customer Support",
      "availableLanguage": ["Indonesian", "English"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "url": siteUrl,
    "name": "PINCK SMILE",
    "description": "Female Intimate Wellness, Thoughtfully",
    "publisher": {
      "@id": `${siteUrl}/#organization`
    },
    "inLanguage": "id-ID"
  }
];

const structuredData = jsonLd 
  ? (Array.isArray(jsonLd) ? [...defaultSchemas, ...jsonLd] : [...defaultSchemas, jsonLd])
  : defaultSchemas;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme & App Metadata -->
    <meta name="theme-color" content="#FFE5F7" />
    <meta name="msapplication-TileColor" content="#FFE5F7" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="PINCK SMILE" />

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="googlecb55c40e4a440bf0" />

    <!-- SEO Search Engine Directives -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="keywords" content="Pinck Smile, female intimate wellness, perawatan intim wanita, kesehatan kewanitaan, pembersih kewanitaan pH seimbang, intimate wash alami, intimate mist, discreet shipping indonesia, body literacy, edukasi kesehatan intim wanita" />
    <meta name="author" content="PINCK SMILE Team" />
    <meta name="publisher" content="PINCK SMILE" />
    <meta name="language" content="Indonesian" />
    <meta name="geo.region" content="ID" />
    <meta name="geo.country" content="ID" />
    
    <!-- Google Fonts for Editorial & Refined Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <SEO
      title={makeTitle}
      description={description}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: article ? "article" : "website",
          title: makeTitle,
          image: ogImageUrl,
        },
        optional: {
          siteName: "PINCK SMILE",
          description: description,
          locale: "id_ID",
        },
        image: {
          alt: "PINCK SMILE - Female Intimate Wellness",
          width: 1200,
          height: 630,
        },
        article: article,
      }}
      twitter={{
        card: "summary_large_image",
        site: "@pincksmile",
        creator: "@pincksmile",
        title: makeTitle,
        description: description,
        image: ogImageUrl,
        imageAlt: "PINCK SMILE - Female Intimate Wellness",
      }}
    />

    <!-- Structured Data / JSON-LD for Google Rich Results -->
    {
      structuredData.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col bg-white text-[#29242A] selection:bg-[#FFE5F7] selection:text-[#29242A]">
    <Navbar />
    <main class="flex-grow" id="main-content">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <style is:global>
      /* Image Rendering Performance */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
