---
import Container from "@/components/container.astro";
---

<section class="relative overflow-hidden pt-12 pb-20 md:pt-16 md:pb-28 bg-gradient-to-b from-[#FFF7FB] via-[#FFF7FB]/60 to-white">
  <!-- Subtle ambient decorative glow circles -->
  <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[650px] h-[350px] bg-[#FFE5F7]/70 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute top-40 right-[-100px] w-[300px] h-[300px] bg-[#FFE5F7]/50 rounded-full blur-2xl pointer-events-none -z-10"></div>

  <Container>
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & CTAs -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <!-- Discreet pill badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/90 border border-[#F0D5E4] shadow-xs text-xs font-medium text-[#756B72]">
          <span class="w-2 h-2 rounded-full bg-[#D98AAF] animate-pulse"></span>
          <span>Thoughtful Intimate Wellness for Women</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-[#29242A] font-serif leading-[1.15]">
          A more confident you starts here.
        </h1>

        <p class="text-lg sm:text-xl text-[#756B72] max-w-xl mx-auto lg:mx-0 font-normal leading-relaxed">
          Female intimate wellness, thoughtfully.
        </p>

        <p class="text-sm text-[#756B72]/90 max-w-lg mx-auto lg:mx-0 leading-relaxed">
          Mendefinisikan ulang perawatan intim wanita dengan produk aman, higienis, dan dirancang dengan penuh kelembutan untuk kenyamanan serta rasa percaya diri Anda setiap hari.
        </p>

        <!-- CTA & Guarantees -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="#produk"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-[#29242A] text-white font-medium text-[15px] hover:bg-[#D98AAF] transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5 group">
            <span>Discover Pinck Smile</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a
            href="#intimate-wellness"
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-white text-[#29242A] border border-[#F0D5E4] font-medium text-[15px] hover:bg-[#FFE5F7] hover:border-[#D98AAF] transition-all duration-200">
            Pelajari Filosofi Kami
          </a>
        </div>

        <!-- Trust Mini-Bar -->
        <div class="pt-6 border-t border-[#F5E6EF] grid grid-cols-3 gap-3 max-w-md mx-auto lg:mx-0 text-left">
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-[#FFE5F7] text-[#D98AAF] flex items-center justify-center shrink-0">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
            </span>
            <span class="text-xs text-[#756B72] font-medium">100% Body Safe</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-[#FFE5F7] text-[#D98AAF] flex items-center justify-center shrink-0">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
            </span>
            <span class="text-xs text-[#756B72] font-medium">Discreet Package</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-[#FFE5F7] text-[#D98AAF] flex items-center justify-center shrink-0">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
            </span>
            <span class="text-xs text-[#756B72] font-medium">pH-Balanced</span>
          </div>
        </div>
      </div>

      <!-- Right Column: PRODUCT IMAGE SHOWCASE -->
      <div class="lg:col-span-5 relative flex justify-center items-center">
        <!-- Visual Backdrop Container -->
        <div class="relative w-full max-w-[420px] aspect-[4/5] rounded-3xl bg-gradient-to-tr from-[#FFE5F7] via-[#FFF7FB] to-white p-6 shadow-xl border border-[#F0D5E4]/80 flex flex-col justify-between overflow-hidden">
          
          <!-- Decorative subtle abstract botanical curves -->
          <div class="absolute -right-12 -top-12 w-48 h-48 rounded-full bg-[#FFE5F7] opacity-60 blur-xl"></div>
          <div class="absolute -left-12 -bottom-12 w-48 h-48 rounded-full bg-[#D98AAF]/15 blur-xl"></div>

          <!-- Top Brand Badge inside visual -->
          <div class="relative z-10 flex justify-between items-center">
            <span class="text-[11px] uppercase tracking-widest text-[#756B72] font-semibold bg-white/80 backdrop-blur-xs px-3 py-1 rounded-full border border-[#F0D5E4]">
              Signature Edition
            </span>
            <span class="text-[#D98AAF] flex items-center gap-1 text-xs font-medium">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              <span>4.9 / 5.0</span>
            </span>
          </div>

          <!-- Product Showcase Artwork / Mockup Display -->
          <div class="relative z-10 my-auto flex flex-col items-center justify-center text-center py-6">
            <!-- Elegant Product Visual representation -->
            <div class="relative w-48 h-60 rounded-2xl bg-white shadow-lg border border-[#F5E6EF] flex flex-col items-center justify-between p-4 transform hover:scale-[1.02] transition-transform duration-300">
              <!-- Bottle / Device aesthetic cap -->
              <div class="w-14 h-6 rounded-t-lg bg-gradient-to-r from-[#D98AAF] to-[#E5A3C0] shadow-xs"></div>
              
              <!-- Center Logo & Minimalist Typography -->
              <div class="space-y-1 w-full flex flex-col items-center">
                <img 
                  src="/pinck-smile-logo.svg" 
                  alt="PINCK SMILE Logo" 
                  class="h-14 w-auto object-contain"
                />
                <div class="text-[10px] text-[#756B72] italic mt-1">Gentle Intimate Care</div>
                <div class="text-[9px] text-[#D98AAF] font-medium tracking-wide">pH 4.0 • Prebiotic Complex</div>
              </div>

              <!-- Bottom volume & certification indicator -->
              <div class="w-full pt-2 border-t border-[#F5E6EF] flex justify-between items-center text-[9px] text-[#756B72]">
                <span>100 ml</span>
                <span class="text-[#D98AAF] font-semibold">Derm-Tested</span>
              </div>
            </div>

            <!-- Floating Companion Pill Element -->
            <div class="absolute -bottom-2 -left-2 bg-white/95 backdrop-blur-md rounded-2xl p-3 shadow-md border border-[#F0D5E4] flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-[#FFE5F7] flex items-center justify-center text-[#D98AAF]">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div class="text-left">
                <div class="text-xs font-semibold text-[#29242A]">Medical Grade Silicone</div>
                <div class="text-[10px] text-[#756B72]">Ultra-soft & Hypoallergenic</div>
              </div>
            </div>

            <!-- Floating Privacy Tag -->
            <div class="absolute -top-1 -right-2 bg-white/95 backdrop-blur-md rounded-2xl px-3 py-2 shadow-md border border-[#F0D5E4] flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span class="text-[11px] font-medium text-[#29242A]">Discreet Packaging Guaranteed</span>
            </div>
          </div>

          <!-- Bottom Card Footer Note -->
          <div class="relative z-10 bg-white/80 backdrop-blur-xs rounded-xl p-2.5 border border-[#F0D5E4] flex items-center justify-between text-xs text-[#756B72]">
            <span>Perawatan Intim Harian</span>
            <span class="font-medium text-[#29242A]">Pure • Gentle • Mindful</span>
          </div>

        </div>
      </div>

    </div>
  </Container>
</section>
