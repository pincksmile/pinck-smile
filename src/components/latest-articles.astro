---
import { getCollection } from "astro:content";
import Container from "@/components/container.astro";

// Get all published blog entries dynamically
const allPosts = await getCollection("blog", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});

// Sort by date descending and take top 3
allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const articles = allPosts.slice(0, 3);
---

<section id="edukasi" class="py-24 bg-[#FFF7FB]/60 border-b border-[#F5E6EF]">
  <Container>
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-white border border-[#F0D5E4] text-xs font-semibold tracking-wider text-[#D98AAF] uppercase mb-3">
          Jurnal & Edukasi
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-semibold text-[#29242A]">
          LATEST FROM PINCK SMILE
        </h2>
        <p class="text-base text-[#756B72] mt-2 max-w-xl">
          Wawasan terpercaya, panduan ilmiah seputar kebugaran intim wanita, stimulasi alami, kepercayaan diri, dan keharmonisan.
        </p>
      </div>

      <div>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-semibold text-[#29242A] hover:text-[#D98AAF] transition-colors group">
          <span>Lihat Semua Artikel ({allPosts.length})</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- Articles Grid -->
    <div class="grid md:grid-cols-3 gap-8">
      {
        articles.map((article) => (
          <article class="bg-white rounded-3xl overflow-hidden border border-[#F0D5E4] shadow-xs brand-card-hover flex flex-col justify-between group">
            <div>
              <!-- Visual Header -->
              <div class="w-full aspect-[16/10] bg-gradient-to-br from-[#FFF7FB] via-[#FFE5F7] to-white p-6 flex flex-col justify-between relative overflow-hidden border-b border-[#F0D5E4]">
                <div class="flex items-center justify-between z-10">
                  <span class="text-[11px] font-semibold text-[#D98AAF] bg-white/90 backdrop-blur-xs px-3 py-1 rounded-full border border-[#F0D5E4]">
                    {article.data.category}
                  </span>
                  <span class="text-[11px] text-[#756B72] font-medium bg-white/80 px-2.5 py-0.5 rounded-full">
                    {article.data.publishDate.toLocaleDateString('id-ID', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </span>
                </div>

                <!-- Abstract Visual Icon Motif -->
                <div class="my-auto self-center text-center opacity-80 group-hover:scale-105 transition-transform duration-300">
                  <span class="text-4xl text-[#D98AAF] font-serif">✦</span>
                </div>

                <div class="text-[10px] text-[#756B72] z-10 flex items-center gap-1">
                  <span>Oleh: {article.data.author}</span>
                </div>
              </div>

              <!-- Article Content -->
              <div class="p-6">
                <span class="text-xs font-semibold text-[#D98AAF] block mb-2">
                  {article.data.category}
                </span>

                <h3 class="text-lg font-serif font-semibold text-[#29242A] group-hover:text-[#D98AAF] transition-colors leading-snug mb-3 line-clamp-2">
                  <a href={`/blog/${article.slug}`}>
                    {article.data.title}
                  </a>
                </h3>

                <p class="text-xs text-[#756B72] leading-relaxed line-clamp-3 mb-4">
                  {article.data.snippet}
                </p>
              </div>
            </div>

            <!-- Footer Author & Action -->
            <div class="px-6 pb-6 pt-2 border-t border-[#F5E6EF] flex items-center justify-between text-xs">
              <span class="text-[#756B72] font-medium">{article.data.tags.slice(0, 2).join(", ")}</span>
              <a
                href={`/blog/${article.slug}`}
                class="font-semibold text-[#D98AAF] group-hover:text-[#29242A] transition-colors flex items-center gap-1">
                <span>Baca Lengkap</span>
                <span class="text-xs">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>
