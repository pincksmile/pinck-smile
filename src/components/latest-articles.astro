---
import { getCollection } from "astro:content";
import Container from "@/components/container.astro";

// Get all published blog entries dynamically
const allPosts = await getCollection("blog", ({ data }) => {
  return !data.draft;
});

// Sort by date descending and take top 3
allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const articles = allPosts.slice(0, 3);
---

<section id="edukasi" class="py-24 bg-[#FFF7FB]/60 border-b border-[#F5E6EF]">
  <Container>
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <p class="text-xs font-semibold tracking-widest text-[#D98AAF] uppercase mb-3">
          Jurnal & Edukasi
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-semibold text-[#29242A] text-balance">
          LATEST FROM PINCK SMILE
        </h2>
        <p class="text-base text-[#756B72] mt-2 max-w-xl leading-relaxed">
          Wawasan terpercaya, panduan ilmiah seputar kebugaran intim wanita, stimulasi alami, kepercayaan diri, dan keharmonisan.
        </p>
      </div>

      <div>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-semibold text-[#29242A] hover:text-[#D98AAF] transition-colors whitespace-nowrap shrink-0 group">
          <span>Lihat Semua Artikel ({allPosts.length})</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- Articles Grid -->
    <div class="grid md:grid-cols-3 gap-8">
      {
        articles.map((article) => (
          <article class="bg-white rounded-3xl overflow-hidden border border-[#F0D5E4] shadow-xs brand-card-hover flex flex-col justify-between group">
            <div>
              <!-- Thumbnail Image with Resilient Fallback -->
              <a
                href={`/blog/${article.slug}`}
                class="block w-full aspect-[16/9] bg-gradient-to-br from-[#FFF7FB] via-[#FFE5F7] to-[#F5E6EF] relative overflow-hidden border-b border-[#F0D5E4]">
                <img
                  src={article.data.image.src}
                  alt={article.data.image.alt}
                  loading="lazy"
                  referrerpolicy="no-referrer"
                  onerror="this.style.display='none'"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out relative z-10"
                />
                <!-- Fallback Decorative State underneath image -->
                <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center z-0">
                  <span class="text-3xl text-[#D98AAF] font-serif mb-1">✦</span>
                  <span class="text-xs font-serif text-[#756B72] line-clamp-1">{article.data.title}</span>
                </div>
                <!-- Subtle bottom gradient scrim for depth -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity duration-300 z-20 pointer-events-none"></div>
              </a>

              <!-- Article Content -->
              <div class="p-6">
                <div class="flex items-center gap-2 text-xs text-[#756B72] mb-2.5">
                  <span class="font-semibold text-[#D98AAF]">{article.data.category}</span>
                  <span aria-hidden="true">·</span>
                  <time datetime={article.data.publishDate.toISOString()}>
                    {article.data.publishDate.toLocaleDateString('id-ID', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </time>
                </div>

                <h3 class="text-lg font-serif font-semibold text-[#29242A] group-hover:text-[#D98AAF] transition-colors leading-snug mb-3 line-clamp-2 text-balance">
                  <a href={`/blog/${article.slug}`}>
                    {article.data.title}
                  </a>
                </h3>

                <p class="text-xs text-[#756B72] leading-relaxed line-clamp-3 mb-4">
                  {article.data.snippet}
                </p>
              </div>
            </div>

            <!-- Footer Author & Action -->
            <div class="px-6 pb-6 pt-3 border-t border-[#F5E6EF] flex items-center justify-between text-xs">
              <span class="text-[#756B72] font-medium truncate max-w-[180px]">Oleh: {article.data.author}</span>
              <a
                href={`/blog/${article.slug}`}
                class="font-semibold text-[#D98AAF] group-hover:text-[#29242A] transition-colors inline-flex items-center gap-1 whitespace-nowrap shrink-0">
                <span>Baca Lengkap</span>
                <span class="text-xs">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>
