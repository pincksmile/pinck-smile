---
import Container from "@/components/container.astro";

const articles = [
  {
    id: "panduan-perawatan-intim-harian",
    title: "Panduan Lengkap Merawat Kesehatan Intim: Menjaga pH & Mikrobiom Seimbang",
    category: "Edukasi & Sains",
    date: "14 Ags 2026",
    readTime: "4 min baca",
    excerpt:
      "Kenapa sabun mandi biasa tidak disarankan untuk area intim? Pelajari sains di balik tingkat keasaman (pH) alami wanita dan cara merawatnya tanpa merusak pelindung alami.",
    author: "dr. Amanda S., Sp.OG",
    imageGradient: "from-[#FFE5F7] to-[#FFF7FB]",
    tag: "Education",
  },
  {
    id: "membangun-kepercayaan-diri-tubuh",
    title: "Body Literacy: Langkah Nyata Membangun Rasa Percaya Diri Tanpa Rasa Malu",
    category: "Confidence",
    date: "10 Ags 2026",
    readTime: "5 min baca",
    excerpt:
      "Menghilangkan rasa bersalah dan kecanggungan seputar anatomi tubuh kita sendiri. Merangkul setiap fase perubahan tubuh dengan penuh cinta dan rasa hormat.",
    author: "Pinck Editorial Team",
    imageGradient: "from-[#FFF7FB] to-[#FFE5F7]",
    tag: "Confidence",
  },
  {
    id: "komunikasi-intim-tanpa-canggung",
    title: "Menciptakan Ruang Aman: Membicarakan Keinginan & Kenyamanan Bersama Pasangan",
    category: "Relationship",
    date: "05 Ags 2026",
    readTime: "6 min baca",
    excerpt:
      "Komunikasi yang jujur adalah kunci utama keintiman yang langgeng. Simak tips praktis membuka obrolan intim dengan pasangan secara hangat dan penuh penghargaan.",
    author: "Nathalia R., M.Psi",
    imageGradient: "from-[#FFE5F7] via-[#FFF7FB] to-white",
    tag: "Relationship",
  },
];
---

<section id="edukasi" class="py-24 bg-[#FFF7FB]/60 border-b border-[#F5E6EF]">
  <Container>
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-white border border-[#F0D5E4] text-xs font-semibold tracking-wider text-[#D98AAF] uppercase mb-3">
          Jurnal & Edukasi
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-semibold text-[#29242A]">
          LATEST FROM PINCK SMILE
        </h2>
        <p class="text-base text-[#756B72] mt-2 max-w-xl">
          Wawasan terpercaya, panduan ilmiah, dan cerita inspiratif seputar kesehatan intim wanita, kepercayaan diri, dan hubungan.
        </p>
      </div>

      <div>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-semibold text-[#29242A] hover:text-[#D98AAF] transition-colors group">
          <span>Lihat Semua Artikel</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- Articles Grid -->
    <div class="grid md:grid-cols-3 gap-8">
      {
        articles.map((article) => (
          <article class="bg-white rounded-3xl overflow-hidden border border-[#F0D5E4] shadow-xs brand-card-hover flex flex-col justify-between group">
            <div>
              <!-- Visual Header -->
              <div class={`w-full aspect-[16/10] bg-gradient-to-br ${article.imageGradient} p-6 flex flex-col justify-between relative overflow-hidden border-b border-[#F0D5E4]`}>
                <div class="flex items-center justify-between z-10">
                  <span class="text-[11px] font-semibold text-[#D98AAF] bg-white/90 backdrop-blur-xs px-3 py-1 rounded-full border border-[#F0D5E4]">
                    {article.tag}
                  </span>
                  <span class="text-[11px] text-[#756B72] font-medium bg-white/80 px-2.5 py-0.5 rounded-full">
                    {article.readTime}
                  </span>
                </div>

                <!-- Abstract Visual Icon Motif -->
                <div class="my-auto self-center text-center opacity-80 group-hover:scale-105 transition-transform duration-300">
                  <span class="text-4xl text-[#D98AAF] font-serif">✦</span>
                </div>

                <div class="text-[10px] text-[#756B72] z-10">
                  {article.date}
                </div>
              </div>

              <!-- Article Content -->
              <div class="p-6">
                <span class="text-xs font-semibold text-[#D98AAF] block mb-2">
                  {article.category}
                </span>

                <h3 class="text-lg font-serif font-semibold text-[#29242A] group-hover:text-[#D98AAF] transition-colors leading-snug mb-3 line-clamp-2">
                  <a href="/blog">
                    {article.title}
                  </a>
                </h3>

                <p class="text-xs text-[#756B72] leading-relaxed line-clamp-3 mb-4">
                  {article.excerpt}
                </p>
              </div>
            </div>

            <!-- Footer Author & Action -->
            <div class="px-6 pb-6 pt-2 border-t border-[#F5E6EF] flex items-center justify-between text-xs">
              <span class="text-[#756B72] font-medium">{article.author}</span>
              <a
                href="/blog"
                class="font-semibold text-[#D98AAF] group-hover:text-[#29242A] transition-colors flex items-center gap-1">
                <span>Baca</span>
                <span class="text-xs">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>
