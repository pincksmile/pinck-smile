const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://pinck-smile.pages.dev";

const defaultShippingDetails = {
  "@type": "OfferShippingDetails",
  "shippingRate": {
    "@type": "MonetaryAmount",
    "value": 0,
    "currency": "IDR",
  },
  "shippingDestination": {
    "@type": "DefinedRegion",
    "addressCountry": "ID",
  },
  "deliveryTime": {
    "@type": "ShippingDeliveryTime",
    "handlingTime": {
      "@type": "QuantitativeValue",
      "minValue": 0,
      "maxValue": 1,
      "unitCode": "DAY",
    },
    "transitTime": {
      "@type": "QuantitativeValue",
      "minValue": 1,
      "maxValue": 3,
      "unitCode": "DAY",
    },
  },
};

const defaultMerchantReturnPolicy = {
  "@type": "MerchantReturnPolicy",
  "applicableCountry": "ID",
  "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
  "merchantReturnDays": 7,
  "returnMethod": "https://schema.org/ReturnByMail",
  "returnFees": "https://schema.org/FreeReturn",
};

const bundlingSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Paket Bundling Hemat PINCK SMILE (Pink Smile)",
  "description": "Daftar paket bundling hemat produk perawatan kewanitaan PINCK SMILE (Pink Smile) dengan diskon hingga 44%, bisa COD, dan privasi paket 100% terjaga.",
  "itemListElement": bundlingPackages.map((pkg, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Product",
      "name": pkg.name,
      "alternateName": `Pink Smile ${pkg.name}`,
      "image": [`${siteUrl}${pkg.image}`],
      "description": pkg.description,
      "sku": pkg.id,
      "mpn": `PS-${pkg.id.toUpperCase()}`,
      "url": `${siteUrl}/products/${pkg.slug}`,
      "brand": {
        "@type": "Brand",
        "name": "PINCK SMILE",
        "alternateName": "Pink Smile",
      },
      "offers": {
        "@type": "Offer",
        "url": `${siteUrl}/${canonicalSlug}`,
        "priceCurrency": "IDR",
        "price": pkg.priceNum,
        "priceValidUntil": "2027-12-31",
        "itemCondition": "https://schema.org/NewCondition",
        "availability": "https://schema.org/InStock",
        "seller": {
          "@type": "Organization",
          "name": "PINCK SMILE",
          "alternateName": "Pink Smile",
        },
        "shippingDetails": defaultShippingDetails,
        "hasMerchantReturnPolicy": defaultMerchantReturnPolicy,
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "1650",
        "bestRating": "5",
        "worstRating": "1",
      },
    },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Beranda",
      "item": siteUrl,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Paket Bundling Hemat",
      "item": `${siteUrl}/${canonicalSlug}`,
    },
  ],
};
---

<Layout
  title="Paket Bundling Hemat PINCK SMILE (Pink Smile) — Diskon Hingga 44% & Bisa COD"
  description="Pilih Paket Bundling Hemat PINCK SMILE: Complete Comfort Duo Set, Twin Pack Gentle Wash, Twin Pack Hydrating Mist, hingga Ultimate 3-in-1 Ritual. Garansi 100% original, kemasan polos rahasia, bisa COD."
  image="/products/complete-comfort-set-og.jpg"
  jsonLd={[bundlingSchema, breadcrumbSchema]}>
  <!-- HERO BANNER PAKET BUNDLING -->
  <section class="relative overflow-hidden bg-gradient-to-b from-[#FFF0F8] via-[#FFF7FB] to-white pt-10 pb-12 border-b border-[#F0D5E4]">
    <Container>
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex flex-wrap items-center justify-center gap-2 px-4 py-1.5 rounded-full bg-white border border-[#E8B8D1] shadow-2xs mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-[#B85080]">
            Official Paket Bundling Hemat • Diskon s/d 44%
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-serif font-semibold text-[#29242A] leading-tight">
          Paket Bundling Perawatan Intim <span class="text-[#D98AAF]">PINCK SMILE</span>
        </h1>

        <p class="mt-4 text-sm sm:text-base text-[#6E626B] leading-relaxed max-w-2xl mx-auto">
          Lebih hemat hingga <strong>Rp 338.000</strong> dengan memilih paket bundling resmi. Semua paket dijamin <strong>100% Original BPOM</strong>, dikirim dengan <strong>kardus polos rahasia (tanpa nama produk di resi)</strong>, dan mendukung pembayaran <strong>COD (Bayar di Tempat)</strong>.
        </p>

        <!-- Trust Highlights Strip -->
        <div class="mt-7 grid grid-cols-2 sm:grid-cols-4 gap-3 text-left max-w-2xl mx-auto">
          <div class="bg-white/90 border border-[#F0D5E4] rounded-2xl p-3 flex items-center gap-2.5 shadow-2xs">
            <span class="w-8 h-8 rounded-full bg-[#FFE5F7] text-[#B85080] flex items-center justify-center font-bold text-sm shrink-0">
              %
            </span>
            <div>
              <p class="text-xs font-bold text-[#29242A]">Hemat s/d 44%</p>
              <p class="text-[11px] text-[#756B72]">Harga Spesial Bundle</p>
            </div>
          </div>

          <div class="bg-white/90 border border-[#F0D5E4] rounded-2xl p-3 flex items-center gap-2.5 shadow-2xs">
            <span class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm shrink-0">
              ✓
            </span>
            <div>
              <p class="text-xs font-bold text-[#29242A]">Bisa COD</p>
              <p class="text-[11px] text-[#756B72]">Bayar Saat Sampai</p>
            </div>
          </div>

          <div class="bg-white/90 border border-[#F0D5E4] rounded-2xl p-3 flex items-center gap-2.5 shadow-2xs">
            <span class="w-8 h-8 rounded-full bg-[#FFE5F7] text-[#B85080] flex items-center justify-center font-bold text-sm shrink-0">
              🔒
            </span>
            <div>
              <p class="text-xs font-bold text-[#29242A]">100% Privasi</p>
              <p class="text-[11px] text-[#756B72]">Kardus Polos Rapat</p>
            </div>
          </div>

          <div class="bg-white/90 border border-[#F0D5E4] rounded-2xl p-3 flex items-center gap-2.5 shadow-2xs">
            <span class="w-8 h-8 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center font-bold text-sm shrink-0">
              🎁
            </span>
            <div>
              <p class="text-xs font-bold text-[#29242A]">Bonus Pouch</p>
              <p class="text-[11px] text-[#756B72]">Silk Pouch Eksklusif</p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- DAFTAR 6 PAKET BUNDLING LENGKAP -->
  <section class="py-14 bg-white" id="katalog-bundling">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
        {
          bundlingPackages.map((pkg) => (
            <article
              class={`rounded-3xl p-6 sm:p-7 border flex flex-col justify-between relative transition-all duration-300 hover:-translate-y-1 ${
                pkg.popular
                  ? "bg-gradient-to-b from-[#FFF7FB] to-white border-2 border-[#D98AAF] shadow-xl"
                  : "bg-white border-[#F0D5E4] shadow-md hover:shadow-lg"
              }`}>
              {/* Top Floating Popular Ribbon */}
              {pkg.popular && (
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[#C81E45] text-white text-[11px] font-extrabold tracking-wider uppercase px-4 py-1 rounded-full shadow-md whitespace-nowrap">
                  ★ {pkg.badge} ★
                </div>
              )}

              <div>
                {/* Top Meta Chips */}
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="inline-block px-3 py-1 rounded-full bg-[#FFE5F7] text-[#B85080] text-[11px] font-bold uppercase tracking-wide">
                    {pkg.discountBadge}
                  </span>
                  <span class="text-[11px] font-semibold text-[#756B72] bg-[#FAF5F8] px-2.5 py-1 rounded-full border border-[#F0D5E4]">
                    {pkg.duration}
                  </span>
                </div>

                {/* Product Visual Box */}
                <a href={`/products/${pkg.slug}`} class="block mb-5 group">
                  <div class="w-full aspect-[4/3] rounded-2xl bg-gradient-to-br from-[#FFE5F7] to-[#FFF7FB] border border-[#F0D5E4] overflow-hidden relative shadow-inner">
                    <ProductVisual id={pkg.visualId} size="md" />
                  </div>
                </a>

                {/* Package Title & Subtitle */}
                <h2 class="text-xl font-serif font-semibold text-[#29242A] leading-snug hover:text-[#D98AAF] transition-colors">
                  <a href={`/products/${pkg.slug}`}>{pkg.name}</a>
                </h2>
                <p class="text-xs font-bold text-[#B85080] mt-1">
                  {pkg.shortLabel}
                </p>
                <p class="text-xs text-[#756B72] mt-2 leading-relaxed">
                  {pkg.description}
                </p>

                {/* Price Box with Strikethrough & Savings */}
                <div class="mt-4 p-4 rounded-2xl bg-[#FFF7FB] border border-[#F0D5E4]">
                  <div class="flex items-center justify-between gap-2">
                    <span class="text-xs text-[#756B72] line-through font-medium">
                      Harga Normal: {pkg.originalPrice}
                    </span>
                    <span class="text-[11px] font-extrabold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full">
                      {pkg.savings}
                    </span>
                  </div>
                  <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-3xl font-extrabold text-[#29242A]">
                      {pkg.price}
                    </span>
                    <span class="text-[11px] font-semibold text-[#756B72]">
                      / paket lengkap
                    </span>
                  </div>
                </div>

                {/* Isi Paket List */}
                <div class="mt-5 pt-4 border-t border-[#F0D5E4]">
                  <p class="text-xs font-bold uppercase tracking-wider text-[#29242A] mb-2.5">
                    Isi Paket Bundling:
                  </p>
                  <ul class="space-y-2">
                    {pkg.itemsIncluded.map((item) => (
                      <li class="flex items-start gap-2 text-xs text-[#29242A]/90">
                        <span class="w-4 h-4 rounded-full bg-[#FFE5F7] text-[#B85080] flex items-center justify-center shrink-0 mt-0.5 font-bold text-[10px]">
                          ✓
                        </span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                {/* Keunggulan Paket */}
                <div class="mt-4 pt-3 border-t border-dashed border-[#F0D5E4] mb-6">
                  <p class="text-[11px] font-bold uppercase tracking-wider text-[#756B72] mb-2">
                    Keunggulan Utama:
                  </p>
                  <ul class="space-y-1.5">
                    {pkg.benefits.map((benefit) => (
                      <li class="flex items-start gap-2 text-[11px] text-[#5C535A]">
                        <span class="text-emerald-600 font-bold">•</span>
                        <span>{benefit}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              {/* Action Buttons */}
              <div class="space-y-2.5 pt-2">
                <button
                  type="button"
                  data-id={pkg.id}
                  data-name={pkg.name}
                  data-price={pkg.priceNum}
                  class={`add-to-cart-btn w-full py-3.5 px-4 rounded-full text-xs font-bold transition-all duration-200 cursor-pointer flex items-center justify-center gap-2 ${
                    pkg.popular
                      ? "bg-[#C81E45] text-white hover:bg-[#A81638] shadow-md"
                      : "bg-[#29242A] text-white hover:bg-[#D98AAF]"
                  }`}>
                  <span>🛍️ + Tambah Paket ke Tas Belanja</span>
                </button>

                <a
                  href={`https://wa.me/6288980874055?text=${encodeURIComponent(
                    `Halo CS Resmi PINCK SMILE, saya mau pesan *${pkg.name}* (${pkg.shortLabel}) dengan harga promo bundling *${pkg.price}* (${pkg.savings}). Mohon diproses dengan kemasan polos rahasia ya.`
                  )}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-3 px-4 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-colors flex items-center justify-center gap-1.5 shadow-xs">
                  <span>💬 Pesan Langsung via WhatsApp (Bisa COD)</span>
                </a>

                <div class="grid grid-cols-2 gap-2 pt-1">
                  <a
                    href="https://s.shopee.co.id/9zx2C9Pfba"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="py-2 px-3 rounded-full bg-[#EE4D2D]/10 text-[#EE4D2D] border border-[#EE4D2D]/30 hover:bg-[#EE4D2D] hover:text-white text-[11px] font-bold text-center transition-colors">
                    Shopee Mall ↗
                  </a>
                  <a
                    href="https://share.google/nJK2B7iDNKitHambl"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="py-2 px-3 rounded-full bg-[#0F146D]/10 text-[#0F146D] border border-[#0F146D]/30 hover:bg-[#0F146D] hover:text-white text-[11px] font-bold text-center transition-colors">
                    Lazada Official ↗
                  </a>
                </div>
              </div>
            </article>
          ))
