      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-8">
          <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-[#29242A]">
            Perbandingan Hemat Beli Paket Bundling vs Satuan
          </h2>
          <p class="text-xs sm:text-sm text-[#756B72] mt-2">
            Semua paket bundling mendapatkan jaminan produk 100% original dengan masa kedaluwarsa panjang.
          </p>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-[#F0D5E4] bg-white shadow-sm">
          <table class="w-full text-left border-collapse text-xs sm:text-sm">
            <thead>
              <tr class="bg-[#29242A] text-white">
                <th class="py-3.5 px-4 font-bold">Nama Paket Bundling</th>
                <th class="py-3.5 px-4 font-bold">Isi Produk</th>
                <th class="py-3.5 px-4 font-bold">Harga Satuan</th>
                <th class="py-3.5 px-4 font-bold text-[#FFEA00]">Harga Bundling</th>
                <th class="py-3.5 px-4 font-bold">Anda Hemat</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#F0D5E4]">
              {
                bundlingPackages.map((pkg) => (
                  <tr class="hover:bg-[#FFF7FB]/60 transition-colors">
                    <td class="py-3.5 px-4 font-bold text-[#29242A]">
                      {pkg.name}
                    </td>
                    <td class="py-3.5 px-4 text-[#6E626B]">{pkg.shortLabel}</td>
                    <td class="py-3.5 px-4 text-[#8E828B] line-through">
                      {pkg.originalPrice}
                    </td>
                    <td class="py-3.5 px-4 font-extrabold text-[#C81E45]">
                      {pkg.price}
                    </td>
                    <td class="py-3.5 px-4 font-bold text-emerald-700">
                      {pkg.savings}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </Container>
  </section>

  <!-- FORM PEMESANAN CEPAT PAKET BUNDLING (BISA COD) -->
  <section class="py-14 bg-white" id="form-bundling">
    <Container>
      <div class="max-w-xl mx-auto rounded-3xl border-2 border-[#D98AAF] bg-[#FFF7FB] p-6 sm:p-8 shadow-xl">
        <div class="text-center mb-6">
          <span class="inline-block bg-[#C81E45] text-white text-[11px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider mb-2">
            Form Order Cepat • Bisa COD
          </span>
          <h2 class="text-2xl font-serif font-semibold text-[#29242A]">
            Pesan Paket Bundling Sekarang
          </h2>
          <p class="text-xs text-[#756B72] mt-1">
            Isi data di bawah ini untuk memesan langsung melalui CS Resmi PINCK SMILE. Privasi nama produk 100% dirahasiakan pada label paket.
          </p>
        </div>

        <form id="bundling-quick-form" class="space-y-4" novalidate>
          <div>
            <label for="bundle-select" class="block text-xs font-bold text-[#29242A] mb-1.5">
              Pilih Paket Bundling <span class="text-red-600">*</span>
            </label>
            <select
              id="bundle-select"
              name="paket"
              class="w-full rounded-xl border border-[#E2C2D3] bg-white px-3.5 py-3 text-xs sm:text-sm font-semibold text-[#29242A] focus:border-[#D98AAF] focus:outline-none">
              {
                bundlingPackages.map((pkg) => (
                  <option value={`${pkg.name} (${pkg.shortLabel}) - ${pkg.price}`}>
                    {pkg.name} — {pkg.price} ({pkg.savings})
                  </option>
                ))
              }
            </select>
          </div>

          <div>
            <label for="bundle-nama" class="block text-xs font-bold text-[#29242A] mb-1">
              Nama Lengkap Penerima <span class="text-red-600">*</span>
            </label>
            <input
              id="bundle-nama"
              type="text"
              required
              placeholder="Contoh: Bunda Rina / Kak Sarah"
              class="w-full rounded-xl border border-[#E2C2D3] bg-white px-3.5 py-2.5 text-sm text-[#29242A] placeholder:text-neutral-400 focus:border-[#D98AAF] focus:outline-none"
            />
          </div>

          <div>
            <label for="bundle-wa" class="block text-xs font-bold text-[#29242A] mb-1">
              Nomor WhatsApp Aktif <span class="text-red-600">*</span>
            </label>
            <input
              id="bundle-wa"
              type="tel"
              required
              placeholder="Contoh: 081234567890"
              class="w-full rounded-xl border border-[#E2C2D3] bg-white px-3.5 py-2.5 text-sm text-[#29242A] placeholder:text-neutral-400 focus:border-[#D98AAF] focus:outline-none"
            />
          </div>

          <div>
            <label for="bundle-alamat" class="block text-xs font-bold text-[#29242A] mb-1">
              Alamat Lengkap Pengiriman <span class="text-red-600">*</span>
            </label>
            <textarea
              id="bundle-alamat"
              rows="3"
              required
              placeholder="Jalan, Nomor Rumah, RT/RW, Kecamatan, Kota/Kabupaten"
              class="w-full rounded-xl border border-[#E2C2D3] bg-white px-3.5 py-2.5 text-sm text-[#29242A] placeholder:text-neutral-400 focus:border-[#D98AAF] focus:outline-none"
            ></textarea>
          </div>

          <div>
            <label for="bundle-metode" class="block text-xs font-bold text-[#29242A] mb-1">
              Metode Pembayaran
            </label>
            <select
              id="bundle-metode"
              class="w-full rounded-xl border border-[#E2C2D3] bg-white px-3.5 py-2.5 text-sm font-semibold text-[#29242A] focus:border-[#D98AAF] focus:outline-none">
              <option value="COD (Bayar di Tempat Saat Paket Sampai)">🚚 COD — Bayar di Tempat Saat Paket Sampai</option>
              <option value="Transfer Bank / QRIS (Prioritas Kirim Hari Ini)">💳 Transfer Bank / QRIS</option>
            </select>
          </div>

          <div id="bundle-form-error" class="hidden rounded-xl bg-red-100 border border-red-300 px-3.5 py-2.5 text-xs font-bold text-red-800">
            Mohon lengkapi Nama Penerima, Nomor WhatsApp, dan Alamat Pengiriman terlebih dahulu.
          </div>

          <button
            type="submit"
            class="w-full py-3.5 px-6 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-lg transition cursor-pointer flex items-center justify-center gap-2">
            <span>🚀 Ambil Paket Bundling via WhatsApp</span>
          </button>
        </form>
      </div>
    </Container>
  </section>

  <script is:inline>
    (function () {
      const form = document.getElementById("bundling-quick-form");
      const err = document.getElementById("bundle-form-error");
      if (form) {
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          const paket = document.getElementById("bundle-select")?.value || "";
          const nama = document.getElementById("bundle-nama")?.value.trim() || "";
          const wa = document.getElementById("bundle-wa")?.value.trim() || "";
          const alamat = document.getElementById("bundle-alamat")?.value.trim() || "";
          const metode = document.getElementById("bundle-metode")?.value || "COD";

          if (!nama || !wa || !alamat) {
            if (err) err.classList.remove("hidden");
            return;
          }
          if (err) err.classList.add("hidden");

          const msg = [
            "Halo CS Resmi *PINCK SMILE*, saya ingin memesan *PAKET BUNDLING HEMAT*:",
            "",
            "🎁 *Paket Bundling:* " + paket,
            "👤 *Nama Penerima:* " + nama,
            "📱 *No. WhatsApp:* " + wa,
            "🏠 *Alamat Lengkap:* " + alamat,
            "💳 *Pembayaran:* " + metode,
            "🔒 *Kemasan:* Kardus Polos Privasi 100% Aman",
            "",
            "Mohon segera diproses ya kak, terima kasih! 🙏",
          ].join("\n");

          window.location.href =
            "https://wa.me/6288980874055?text=" + encodeURIComponent(msg);
        });
      }
    })();
  </script>
</Layout>
