---
// Interactive Consultation & Contact Form for PINCK SMILE
---

<form
  id="contact-form"
  class="space-y-4">
  
  <div>
    <label for="topic" class="block text-xs font-semibold text-[#29242A] mb-1.5">
      Topik Konsultasi / Keperluan
    </label>
    <select
      id="topic"
      name="topic"
      required
      class="w-full px-4 py-3 rounded-2xl border border-[#F0D5E4] bg-[#FFF7FB] text-xs text-[#29242A] focus:outline-none focus:border-[#D98AAF]">
      <option value="Konsultasi Produk Perawatan">Konsultasi Produk Perawatan Intim</option>
      <option value="Panduan Penggunaan">Panduan Penggunaan Perangkat Aura</option>
      <option value="Privasi Pengiriman & Discreet Order">Pertanyaan Pengiriman & Privasi</option>
      <option value="Pesanan Khusus / Mitra">Pemesanan Khusus / Kemitraan</option>
      <option value="Lainnya">Lainnya</option>
    </select>
  </div>

  <div>
    <label for="name" class="block text-xs font-semibold text-[#29242A] mb-1.5">
      Nama / Inisial
    </label>
    <input
      type="text"
      id="name"
      name="name"
      placeholder="Nama panggilan atau inisial Anda"
      required
      class="w-full px-4 py-3 rounded-2xl border border-[#F0D5E4] bg-[#FFF7FB] text-xs text-[#29242A] focus:outline-none focus:border-[#D98AAF]"
    />
  </div>

  <div>
    <label for="contact_info" class="block text-xs font-semibold text-[#29242A] mb-1.5">
      Nomor WhatsApp atau Email
    </label>
    <input
      type="text"
      id="contact_info"
      name="contact_info"
      placeholder="0812xxxx atau email@domain.com"
      required
      class="w-full px-4 py-3 rounded-2xl border border-[#F0D5E4] bg-[#FFF7FB] text-xs text-[#29242A] focus:outline-none focus:border-[#D98AAF]"
    />
  </div>

  <div>
    <label for="message" class="block text-xs font-semibold text-[#29242A] mb-1.5">
      Pesan / Pertanyaan Anda
    </label>
    <textarea
      id="message"
      name="message"
      rows="4"
      required
      placeholder="Ceritakan apa yang bisa kami bantu (dijamin 100% rahasia)..."
      class="w-full px-4 py-3 rounded-2xl border border-[#F0D5E4] bg-[#FFF7FB] text-xs text-[#29242A] focus:outline-none focus:border-[#D98AAF] resize-none"
    ></textarea>
  </div>

  <div class="pt-2 space-y-2">
    <button
      type="submit"
      class="w-full py-3.5 rounded-full bg-[#D98AAF] text-white text-xs font-semibold hover:bg-[#C6759B] transition-colors shadow-sm cursor-pointer">
      Kirim Pesan Konsultasi
    </button>

    <button
      type="button"
      id="wa-direct-btn"
      class="w-full py-3 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold hover:bg-emerald-100 transition-colors flex items-center justify-center gap-2 cursor-pointer">
      <span>Konsultasi Langsung via WhatsApp Concierge</span>
      <span class="text-xs">↗</span>
    </button>
  </div>

  <!-- Status Alert -->
  <div id="form-status" class="text-xs text-center py-2 hidden rounded-xl"></div>
</form>

<script is:inline>
  (function () {
    const form = document.getElementById("contact-form");
    const statusEl = document.getElementById("form-status");
    const waBtn = document.getElementById("wa-direct-btn");

    if (form) {
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        const name = document.getElementById("name").value.trim();
        const topic = document.getElementById("topic").value;
        const message = document.getElementById("message").value.trim();

        if (statusEl) {
          statusEl.className = "text-xs text-center py-2.5 px-3 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200 block";
          statusEl.textContent = `Terima kasih, ${name || "Kak"}! Pesan Anda telah diterima tim PINCK SMILE. Kami akan merespons secara privat dalam 1x24 jam.`;
        }

        form.reset();
      });
    }

    if (waBtn) {
      waBtn.addEventListener("click", function () {
        const topic = document.getElementById("topic")?.value || "Konsultasi";
        const msg = encodeURIComponent(`Halo Tim PINCK SMILE,\nSaya ingin berkonsultasi secara privat mengenai: ${topic}.`);
        window.open(`https://wa.me/?text=${msg}`, "_blank");
      });
    }
  })();
</script>
