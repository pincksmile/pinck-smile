---
import Container from "@/components/container.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  {
    title: "Produk",
    path: "/pricing",
  },
  {
    title: "Intimate Wellness",
    path: "/#intimate-wellness",
  },
  {
    title: "Edukasi",
    path: "/blog",
  },
  {
    title: "Tentang",
    path: "/about",
  },
  {
    title: "Kontak",
    path: "/contact",
  },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-[#F5E6EF]/80 transition-all duration-200">
  <Container>
    <div class="flex flex-col lg:flex-row justify-between items-center py-3">
      <Astronav>
        <div class="flex w-full lg:w-auto items-center justify-between">
          <a href="/" class="flex items-center gap-3 group text-decoration-none py-1">
            <img 
              src="/pinck-smile-logo.svg" 
              alt="PINCK SMILE - Female Mood Booster" 
              class="h-10 sm:h-12 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
              width="150"
              height="48"
            />
          </a>
          <div class="block lg:hidden">
            <MenuIcon class="w-6 h-6 text-[#29242A] cursor-pointer" />
          </div>
        </div>

        <MenuItems class="hidden w-full lg:w-auto mt-4 lg:flex lg:mt-0 items-center">
          <ul class="flex flex-col lg:flex-row lg:items-center gap-1 lg:gap-8 text-[15px] font-medium text-[#756B72]">
            {
              menuitems.map((item) => (
                <li>
                  <a
                    href={item.path}
                    class="block py-2 lg:py-0 hover:text-[#29242A] transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-[#D98AAF] hover:after:w-full after:transition-all after:duration-200">
                    {item.title}
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="lg:hidden flex flex-col gap-3 pt-4 border-t border-[#F5E6EF] mt-4 w-full">
            <button
              type="button"
              onclick="document.getElementById('floating-cart-btn')?.click()"
              class="w-full text-center px-6 py-2.5 rounded-full bg-[#D98AAF] text-white font-medium text-sm hover:bg-[#C6759B] transition-colors shadow-sm flex items-center justify-center gap-2">
              <span>Tas Belanja</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
            </button>
          </div>
        </MenuItems>
      </Astronav>

      <div class="hidden lg:flex items-center gap-4">
        <button
          type="button"
          onclick="document.getElementById('floating-cart-btn')?.click()"
          class="inline-flex items-center justify-center px-6 py-2 rounded-full bg-[#D98AAF] text-white font-medium text-sm hover:bg-[#C6759B] transition-all duration-200 shadow-sm hover:shadow hover:-translate-y-0.5 group">
          <span>Shop / Bag</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 ml-1.5 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </button>
      </div>
    </div>
  </Container>
</header>
