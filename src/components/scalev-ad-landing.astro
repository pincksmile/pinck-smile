    <!-- CLIENT-SIDE FORM & AD TRACKING SCRIPT -->
    <script is:inline>
      (function () {
        // Hide Ad Manager helper bar automatically if visitor comes from Meta/TikTok/Google Paid Ads
        const params = new URLSearchParams(window.location.search);
        const adBar = document.getElementById("ad-manager-bar");
        if (
          params.has("fbclid") ||
          params.has("utm_source") ||
          params.has("ttclid") ||
          params.has("gclid")
        ) {
          if (adBar) adBar.style.display = "none";
        }

        const closeBtn = document.getElementById("close-ad-bar-btn");
        if (closeBtn && adBar) {
          closeBtn.addEventListener("click", function () {
            adBar.style.display = "none";
          });
        }

        const copyBtn = document.getElementById("copy-ad-url-btn");
        if (copyBtn) {
          copyBtn.addEventListener("click", function () {
            const adUrl =
              window.location.origin +
              window.location.pathname +
              "?utm_source=fb&utm_medium=paid&utm_campaign=promo_diskon_30";
            navigator.clipboard.writeText(adUrl).then(function () {
              copyBtn.textContent = "✓ Link Iklan Tersalin!";
              setTimeout(function () {
                copyBtn.textContent = "Salin Link Iklan FB/IG";
              }, 2500);
            });
          });
        }

        // Order Form Submission Handler -> Direct WhatsApp Concierge
        const form = document.getElementById("scalev-order-form");
        const errorBox = document.getElementById("form-error-msg");
        const successBox = document.getElementById("form-success-msg");

        if (form) {
          form.addEventListener("submit", function (e) {
            e.preventDefault();
            const namaEl = document.getElementById("input-nama");
            const waEl = document.getElementById("input-wa");
            const alamatEl = document.getElementById("input-alamat");
            const metodeEl = document.getElementById("input-metode");
            const selectedPaket = form.querySelector('input[name="paket"]:checked');

            const nama = namaEl ? namaEl.value.trim() : "";
            const waRaw = waEl ? waEl.value.trim() : "";
            const alamat = alamatEl ? alamatEl.value.trim() : "";
            const metode = metodeEl ? metodeEl.value : "COD";
            const paket = selectedPaket ? selectedPaket.value : "Paket Promo Diskon 30% - Rp 195.000";

            if (!nama || !waRaw || !alamat) {
              if (errorBox) errorBox.classList.remove("hidden");
              if (successBox) successBox.classList.add("hidden");
              return;
            }

            if (errorBox) errorBox.classList.add("hidden");
            if (successBox) successBox.classList.remove("hidden");

            const cleanWa = waRaw.replace(/^0+/, "");
            const utmSource = params.get("utm_source") || (params.has("fbclid") ? "Facebook Ads" : "Website LP");
            const utmCampaign = params.get("utm_campaign") || "Promo Diskon 30%";

            const message = [
              "Halo CS Resmi *PINCK SMILE*, saya mau ambil *PROMO DISKON 30%* dari Halaman Promo:",
              "",
              "📦 *Paket:* " + paket,
              "👤 *Nama Penerima:* " + nama,
              "📱 *No. WhatsApp:* +62" + cleanWa,
              "🏠 *Alamat Lengkap:* " + alamat,
              "💳 *Pembayaran:* " + metode,
              "🔒 *Request:* Kemasan Polos Privasi 100% Aman",
              "📊 *Sumber:* " + utmSource + " (" + utmCampaign + ")",
              "",
              "Mohon segera diproses ya kak, terima kasih! 🙏",
            ].join("\n");

            const waUrl =
              "https://wa.me/6288980874055?text=" + encodeURIComponent(message);

            setTimeout(function () {
              window.location.href = waUrl;
            }, 400);
          });
        }
      })();
    </script>
