---
import { SEO } from "astro-seo";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = "Promo Spesial Pinck Smile Diskon 30% — Solusi Perawatan Kewanitaan & Keharmonisan Alami (Bisa COD)",
  description = "Atasi keputihan berlebih, bau tak sedap, gatal, dan jaga keseimbangan pH 4.0 area intim dengan Pinck Smile. Promo Diskon 30% hari ini, garansi 100% original, privasi paket tertutup rapat, bisa bayar di tempat (COD).",
  canonicalPath = "/promo-spesial",
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : "https://pinck-smile.pages.dev";
const canonicalURL = new URL(canonicalPath, siteUrl).toString();
const ogImageUrl = new URL("/products/complete-comfort-set-og.jpg", siteUrl).toString();
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#990000" />
    <meta name="robots" content="index, follow" />

    <!-- Google Fonts for High-Impact Direct-Response Ad Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo+Black&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,700&display=swap"
      rel="stylesheet"
    />

    <SEO
      title={title}
      description={description}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: title,
          image: ogImageUrl,
        },
        image: {
          alt: "Promo Spesial Pinck Smile Diskon 30% Bisa COD",
        },
      }}
    />

    <style is:inline>
      .font-impact {
        font-family: 'Anton', 'Archivo Black', Impact, sans-serif;
        letter-spacing: 0.02em;
      }
      .font-black-display {
        font-family: 'Archivo Black', 'Plus Jakarta Sans', sans-serif;
      }
      .font-body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      }
      .text-stroke-white {
        -webkit-text-stroke: 4px #ffffff;
        paint-order: stroke fill;
      }
      .text-stroke-white-sm {
        -webkit-text-stroke: 2.5px #ffffff;
        paint-order: stroke fill;
      }
      .text-stroke-black {
        -webkit-text-stroke: 3px #000000;
        paint-order: stroke fill;
      }
      .text-stroke-red {
        -webkit-text-stroke: 3px #8b0000;
        paint-order: stroke fill;
      }
      @keyframes bounceDown {
        0%, 100% { transform: translateY(0); opacity: 1; }
        50% { transform: translateY(8px); opacity: 0.75; }
      }
      @keyframes pulseGlow {
        0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); }
        50% { transform: scale(1.03); box-shadow: 0 0 25px 6px rgba(250, 204, 21, 0.75); }
      }
      .animate-chevron {
        animation: bounceDown 1.1s infinite ease-in-out;
      }
      .animate-cta-pulse {
        animation: pulseGlow 1.6s infinite ease-in-out;
      }
    </style>
  </head>

  <body class="bg-[#ECECEC] font-body text-neutral-900 antialiased selection:bg-red-700 selection:text-yellow-300 pb-20">
    <!-- Top Helper Bar for Owner / Ad Manager (Automatically hidden when accessed with ?fbclid= or can be dismissed) -->
    <div id="ad-manager-bar" class="bg-neutral-900 text-white text-xs py-2 px-3 border-b border-neutral-700">
      <div class="max-w-[640px] mx-auto flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span class="font-semibold text-amber-300">Mode Landing Page Iklan (Scalev Style)</span>
          <a href="/" class="text-neutral-300 underline hover:text-white ml-1">← Kembali ke Beranda</a>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="copy-ad-url-btn"
            class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-2.5 py-1 rounded text-[11px] transition cursor-pointer">
            Salin Link Iklan FB/IG
          </button>
          <button
            type="button"
            id="close-ad-bar-btn"
            aria-label="Tutup panel"
            class="text-neutral-400 hover:text-white px-1 text-sm leading-none cursor-pointer">
            ✕
          </button>
        </div>
      </div>
    </div>

    <!-- MAIN SCALEV CANVAS CONTAINER (640px Centered Direct-Response Stack) -->
    <main class="max-w-[640px] w-full mx-auto bg-white shadow-[0_0_40px_rgba(0,0,0,0.18)] overflow-hidden flex flex-col">

      <!-- ===================================================================== -->
      <!-- POSTER 1: HERO PROBLEM & AGITATION (Matches Scalev Image 1)           -->
      <!-- ===================================================================== -->
      <section class="relative w-full overflow-hidden bg-[#D5D5D5] select-none" id="poster-1">
        <!-- Textured Studio Image Base -->
        <div class="relative w-full aspect-[9/15] sm:aspect-[9/14] flex flex-col justify-between">
          <img
            src="/lp/hero-problem.jpg"
            alt="Cegah Masalah Kewanitaan Sebelum Merusak Keharmonisan Dengan Pinck Smile"
            class="absolute inset-0 w-full h-full object-cover object-center grayscale contrast-125 brightness-95"
            fetchpriority="high"
          />
          <!-- Top Light Concrete Vignette for High-Contrast Headline Readability -->
          <div class="absolute inset-x-0 top-0 h-[44%] bg-gradient-to-b from-[#E5E5E5] via-[#E5E5E5]/90 to-transparent"></div>
          <!-- Red Problem Glow on Lower Abdomen -->
          <div class="absolute left-1/2 top-[63%] -translate-x-1/2 -translate-y-1/2 w-56 h-56 rounded-full bg-red-600/55 blur-2xl pointer-events-none"></div>

          <!-- Top Headline Block -->
          <div class="relative z-10 pt-6 sm:pt-8 px-3 text-center flex flex-col items-center">
            <h1 class="font-impact uppercase leading-[1.08] tracking-wide text-[34px] sm:text-[48px] drop-shadow-[0_3px_6px_rgba(0,0,0,0.35)]">
              <span class="text-black text-stroke-white">CEGAH </span>
              <span class="text-[#9E0B0F] text-stroke-white">MASALAH KEWANITAAN</span>
              <br />
              <span class="text-black text-stroke-white">SEBELUM </span>
              <span class="text-[#9E0B0F] text-stroke-white">SUAMI MENJAUH</span>
            </h1>

            <!-- Dark Red Pill Badge -->
            <div class="mt-3 sm:mt-4 inline-flex items-center justify-center bg-[#990000] border-2 border-[#7A0000] rounded-full px-7 sm:px-10 py-2 sm:py-2.5 shadow-lg">
              <span class="font-black-display text-[#FFEA00] text-lg sm:text-2xl tracking-wide uppercase drop-shadow-[0_2px_2px_rgba(0,0,0,0.8)]">
                DENGAN PINCK SMILE
              </span>
            </div>
          </div>

          <!-- Middle Anatomical / Microbiome Inset Zoom Circle + Red Beam -->
          <div class="relative z-10 px-4 sm:px-8 my-auto flex items-center">
            <div class="relative flex items-center">
              <!-- Red Spotlight Cone -->
              <div
                class="hidden sm:block w-36 h-28 bg-gradient-to-r from-red-700/75 to-red-600/10 -ml-6"
                style="clip-path: polygon(0 15%, 100% 38%, 100% 62%, 0 85%); position: absolute; left: 135px; top: 50%; transform: translateY(-50%); width: 170px; height: 140px;"
              ></div>
              <!-- Circular Zoom Graphic -->
              <div class="relative w-36 h-36 sm:w-44 sm:h-44 rounded-full border-[6px] border-[#990000] bg-gradient-to-br from-[#520000] via-[#8B0000] to-[#3A0000] shadow-2xl overflow-hidden flex flex-col items-center justify-center p-3 text-center">
                <!-- Simulated Microbiome / pH Imbalance Visual -->
                <div class="w-full h-full rounded-full border border-red-400/40 bg-[radial-gradient(circle_at_center,#ef4444_0%,#7f1d1d_65%,#450a0a_100%)] flex flex-col items-center justify-center p-2">
                  <span class="bg-yellow-400 text-red-950 font-extrabold text-[10px] sm:text-xs px-2 py-0.5 rounded-full uppercase tracking-tighter mb-1">
                    pH &gt; 5.5 RUSAK
                  </span>
                  <p class="text-white font-extrabold text-xs sm:text-sm leading-tight drop-shadow">
                    Bakteri, Jamur &amp; Bau Berkembang Cepat!
                  </p>
                  <div class="mt-1.5 flex gap-1">
                    <span class="w-2.5 h-2.5 rounded-full bg-yellow-300 animate-pulse"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-red-300 animate-pulse"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-yellow-300 animate-pulse"></span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Dark Red Warning Banner -->
          <div class="relative z-10 bg-[#990000] border-t-4 border-[#FFEA00] px-4 sm:px-6 py-4 sm:py-5 flex items-center gap-3.5 sm:gap-5">
            <!-- Yellow Exclamation Triangle -->
            <div class="shrink-0 w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center">
              <svg viewBox="0 0 100 90" class="w-full h-full drop-shadow-md">
                <polygon points="50,4 96,86 4,86" fill="#FFCC00" stroke="#E6AC00" stroke-width="4" stroke-linejoin="round" />
                <rect x="45" y="28" width="10" height="32" rx="5" fill="#1F2937" />
                <circle cx="50" cy="72" r="5.5" fill="#1F2937" />
              </svg>
            </div>
            <p class="font-black-display uppercase text-sm sm:text-[19px] leading-[1.25] tracking-tight text-white">
              <span class="text-[#FFEA00]">SATU KETIDAKSEIMBANGAN pH KECIL</span> DI AREA INTIM SUDAH CUKUP UNTUK <span class="text-[#FFEA00]">MERUSAK KENYAMANAN &amp; KEHARMONISAN ANDA !!</span>
            </p>
          </div>
        </div>
      </section>

      <!-- ===================================================================== -->
      <!-- POSTER 2: "SUDAH BANYAK KASUSNYA" NEWS CLIPPINGS (Matches Image 2)     -->
      <!-- ===================================================================== -->
      <section class="w-full bg-white pt-6 pb-5 px-3 sm:px-5" id="poster-2">
        <h2 class="font-impact text-center text-black uppercase text-[34px] sm:text-[46px] leading-none tracking-tight mb-4">
          SUDAH BANYAK KASUSNYA
        </h2>

        <!-- Deep Red News Clippings Container -->
        <div class="bg-[#990000] rounded-[26px] p-3.5 sm:p-6 shadow-lg flex flex-col gap-3.5">
          <p class="font-black-display text-center uppercase text-[#FFEA00] text-lg sm:text-2xl leading-snug drop-shadow-[0_2px_2px_rgba(0,0,0,0.85)] px-2">
            “KEPUTIHAN &amp; BAU TAK SEDAP DIBIARKAN,<br />RASA PERCAYA DIRI &amp; KEHARMONISAN HILANG SEKETIKA”
          </p>

          <!-- News Card 1 -->
          <div class="bg-white rounded-xl overflow-hidden shadow-md border border-neutral-200">
            <div class="bg-[#004A8F] text-white px-3.5 py-2 flex items-center justify-between text-[10px] sm:text-xs font-bold tracking-wider">
              <span class="font-serif text-xs sm:text-sm tracking-normal">SUARA KESEHATAN WANITA</span>
              <div class="hidden sm:flex gap-3 text-[10px] opacity-90">
                <span>HOME</span>
                <span>KESEHATAN</span>
                <span>KELUARGA</span>
                <span>EDUKASI</span>
              </div>
            </div>
            <div class="p-3.5 sm:p-4">
              <p class="text-[11px] text-neutral-500 mb-1">Beranda &gt; Kesehatan Intim Wanita</p>
              <h3 class="font-bold text-neutral-900 text-base sm:text-[21px] leading-snug">
                78% Wanita Mengalami <span class="inline-block border-2 border-[#990000] px-1.5 py-0.5 text-[#990000] bg-red-50">Keputihan &amp; Bau Tak Sedap</span> Akibat pH Area Intim Tidak Seimbang
              </h3>
              <p class="text-[11px] text-neutral-400 mt-1.5">by Redaksi Kesehatan — 16 Oktober 2025</p>
              <p class="text-xs text-neutral-600 mt-2 leading-relaxed">
                <strong>JAKARTA</strong> — Dokter spesialis kesehatan wanita mengingatkan bahwa penggunaan sabun mandi biasa dengan pH basa pada area kewanitaan justru mematikan bakteri baik <em>Lactobacillus</em> dan memicu gatal, bau tak sedap, hingga infeksi berulang.
              </p>
            </div>
          </div>

          <!-- News Card 2 -->
          <div class="bg-white rounded-xl p-2.5 sm:p-3 shadow-md border border-neutral-200 flex gap-3 items-center">
            <img
              src="/blog/panduan-perawatan-intim-wanita-ph-seimbang.jpg"
              alt="Kasus Infeksi dan Gatal Area Kewanitaan"
              class="w-28 h-20 sm:w-36 sm:h-24 object-cover rounded-lg shrink-0"
              loading="lazy"
            />
            <div class="flex-1 min-w-0">
              <span class="text-[10px] font-semibold text-neutral-400 uppercase">Medis &amp; Gaya Hidup</span>
              <h3 class="font-bold text-neutral-900 text-xs sm:text-[15px] leading-snug mt-0.5">
                Sering Dianggap Sepele, <span class="inline-block border-2 border-[#990000] px-1 text-[#990000] bg-red-50">Gatal &amp; Iritasi Kewanitaan</span> Bikin Wanita Stres dan Kurang Nyaman Beraktivitas
              </h3>
              <p class="text-[10px] text-neutral-400 mt-1">30 Juli 2025 - 10:31 WIB</p>
            </div>
          </div>

          <!-- News Card 3 -->
          <div class="bg-white rounded-xl p-2.5 sm:p-3 shadow-md border border-neutral-200 flex gap-3 items-center">
            <img
              src="/blog/tips-komunikasi-keintiman-sehat-dan-terbuka.jpg"
              alt="Keharmonisan Rumah Tangga Terganggu"
              class="w-28 h-20 sm:w-36 sm:h-24 object-cover rounded-lg shrink-0"
              loading="lazy"
            />
            <div class="flex-1 min-w-0">
              <span class="text-[10px] font-semibold text-neutral-400 uppercase">Harmoni Pasutri</span>
              <h3 class="font-bold text-neutral-900 text-xs sm:text-[15px] leading-snug mt-0.5">
                Survei: Masalah <span class="inline-block border-2 border-[#990000] px-1 text-[#990000] bg-red-50">Bau &amp; Kurang Percaya Diri</span> Jadi Pemicu Utama Istri Menolak Momen Intim Bersama Suami
              </h3>
              <p class="text-[10px] text-neutral-400 mt-1">05 Oktober 2025 - 20:05 WIB</p>
            </div>
          </div>
        </div>

        <!-- Bottom Yellow Callout Box -->
        <div class="mt-4 bg-[#FFEA00] border-[3.5px] border-black rounded-2xl py-3.5 px-4 text-center shadow-md">
          <p class="font-impact uppercase text-2xl sm:text-[32px] leading-tight tracking-wide">
            <span class="text-black">KENALI </span>
            <span class="text-[#990000]">TANDA AREA KEWANITAAN </span>
            <span class="text-black">ANDA SEDANG</span>
            <br />
            <span class="text-[#990000]">TERANCAM</span>
          </p>
        </div>
      </section>

      <!-- ===================================================================== -->
      <!-- POSTER 3: 4 RED SYMPTOM BARS + YELLOW WARNING (Matches Image 3)       -->
      <!-- ===================================================================== -->
      <section class="w-full bg-white py-3 px-4 sm:px-8 flex flex-col gap-3.5" id="poster-3">
        <div class="bg-[#8F0000] border-[3px] border-black rounded-2xl py-4 px-3 text-center shadow">
          <span class="font-impact uppercase text-[#FFEA00] text-2xl sm:text-[34px] tracking-wide drop-shadow-[0_2px_2px_rgba(0,0,0,0.9)]">
            KEPUTIHAN BERLEBIH &amp; BERWARNA
          </span>
        </div>

        <div class="bg-[#8F0000] border-[3px] border-black rounded-2xl py-4 px-3 text-center shadow">
          <span class="font-impact uppercase text-[#FFEA00] text-2xl sm:text-[34px] tracking-wide drop-shadow-[0_2px_2px_rgba(0,0,0,0.9)]">
            BAU TAK SEDAP WALAU SUDAH MANDI
          </span>
        </div>

        <div class="bg-[#8F0000] border-[3px] border-black rounded-2xl py-4 px-3 text-center shadow">
          <span class="font-impact uppercase text-[#FFEA00] text-2xl sm:text-[34px] tracking-wide drop-shadow-[0_2px_2px_rgba(0,0,0,0.9)]">
            GATAL, PERIH &amp; LEMBAP SEHARIAN
          </span>
        </div>

        <div class="bg-[#8F0000] border-[3px] border-black rounded-2xl py-4 px-3 text-center shadow">
          <span class="font-impact uppercase text-[#FFEA00] text-2xl sm:text-[34px] tracking-wide drop-shadow-[0_2px_2px_rgba(0,0,0,0.9)]">
            KURANG KESAT &amp; HILANG PERCAYA DIRI
          </span>
        </div>

        <!-- Yellow Warning Box with Left & Right Triangles -->
        <div class="mt-2 bg-[#FFEA00] border-[4px] border-black rounded-2xl py-3.5 px-3 sm:px-5 flex items-center justify-between gap-2 shadow-md">
          <svg viewBox="0 0 100 90" class="w-11 h-11 sm:w-14 sm:h-14 shrink-0">
            <polygon points="50,6 95,85 5,85" fill="#FFCC00" stroke="#000000" stroke-width="6" stroke-linejoin="round" />
            <rect x="45" y="28" width="10" height="30" rx="4" fill="#000000" />
            <circle cx="50" cy="70" r="5.5" fill="#000000" />
          </svg>
          <p class="font-black-display uppercase text-black text-center text-base sm:text-[22px] leading-tight">
            RAWAT AREA INTIM ANDA<br />SEBELUM SEMAKIN PARAH
          </p>
          <svg viewBox="0 0 100 90" class="w-11 h-11 sm:w-14 sm:h-14 shrink-0">
            <polygon points="50,6 95,85 5,85" fill="#FFCC00" stroke="#000000" stroke-width="6" stroke-linejoin="round" />
            <rect x="45" y="28" width="10" height="30" rx="4" fill="#000000" />
            <circle cx="50" cy="70" r="5.5" fill="#000000" />
          </svg>
        </div>
      </section>

      <!-- ===================================================================== -->
      <!-- POSTER 4: "JANGAN SEPELEKAN / WASPADA !!" (Matches Image 4)           -->
      <!-- ===================================================================== -->
      <section class="w-full bg-white pt-4 pb-2" id="poster-4">
        <!-- Top Red Header Bar -->
        <div class="bg-[#D60000] py-3 px-4 text-center">
          <h2 class="font-black-display uppercase text-white text-2xl sm:text-4xl tracking-tight">
            JANGAN SEPELEKAN
          </h2>
        </div>

        <!-- Dramatic Visual Section -->
        <div class="relative w-full aspect-[4/3] overflow-hidden bg-neutral-900">
          <img
            src="/blog/memahami-perangsang-wanita-alami-dan-mood-booster.jpg"
            alt="Jangan Sepelekan Masalah Kewanitaan"
            class="w-full h-full object-cover opacity-80 contrast-125"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#8B0000] via-transparent to-white/30"></div>

          <!-- Bottom Red Alert Box Overlay -->
          <div class="absolute inset-x-3 sm:inset-x-6 bottom-3 sm:bottom-5 bg-[#CC0000] border-[3px] border-white/90 rounded-lg p-3 sm:p-4 text-center shadow-2xl">
            <p class="font-black-display uppercase text-[#FFEA00] text-3xl sm:text-5xl leading-none tracking-wide drop-shadow">
              WASPADA !!
            </p>
            <p class="font-black-display uppercase text-[#FFEA00] text-base sm:text-2xl leading-tight mt-1.5">
              JANGAN TUNGGU SAMPAI INFEKSI KRONIS<br />&amp; KEHARMONISAN RUMAH TANGGA RETAAK
            </p>
          </div>
        </div>
      </section>

      <!-- ===================================================================== -->
      <!-- POSTER 5: HERO PRODUCT SOLUTION REVEAL (Matches Image 5)              -->
      <!-- ===================================================================== -->
      <section class="relative w-full overflow-hidden bg-gradient-to-b from-[#E8F4FA] via-[#D4EEF9] to-[#990000]" id="poster-5">
        <div class="relative pt-7 pb-0 flex flex-col items-center text-center">
          <!-- Headline Stack -->
          <div class="px-4 z-10">
            <h2 class="font-black-display italic uppercase text-[#CC0000] text-3xl sm:text-5xl leading-tight text-stroke-white drop-shadow-md">
              PINCK SMILE<br />PILIHAN TERBAIK
            </h2>
            <p class="font-black-display italic text-black text-base sm:text-2xl mt-1 text-stroke-white-sm">
              Untuk Perawatan Intim &amp; Keharmonisan Wanita
            </p>

            <!-- White Verified Badge Pill -->
            <div class="mt-2.5 inline-flex items-center gap-1.5 bg-white px-4 py-1 rounded-full shadow border border-sky-100">
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-sky-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="font-extrabold text-black text-xs sm:text-base">
                Formula pH 4.0 Botanical Pertama
              </span>
            </div>

            <!-- Dark Red Pill -->
            <div class="mt-2">
              <span class="inline-block bg-[#990000] text-[#FFEA00] font-black-display italic uppercase text-xs sm:text-lg px-6 py-1.5 rounded-full shadow-md">
                UNTUK WANITA AKTIF &amp; ISTRI TERCINTA
              </span>
            </div>
          </div>

          <!-- Center Botanical Product Podium Graphic -->
          <div class="relative w-full mt-3">
            <img
              src="/lp/botanical-podium.jpg"
              alt="Pinck Smile Botanical Formula Podium"
              class="w-full aspect-[4/4] object-cover object-bottom"
              loading="lazy"
            />
            <!-- Official Pinck Smile Complete Set Bottle Card Overlay Badge -->
            <div class="absolute bottom-4 right-3 sm:right-6 bg-white/95 backdrop-blur-sm border-2 border-[#D98AAF] rounded-2xl p-2 sm:p-2.5 shadow-xl flex items-center gap-2.5 max-w-[230px] sm:max-w-[260px] text-left">
              <img
                src="/products/complete-comfort-set.jpg"
                alt="Pinck Smile Complete Comfort Set"
                class="w-14 h-14 sm:w-16 sm:h-16 object-cover rounded-xl shrink-0 border border-pink-200"
              />
              <div>
                <span class="inline-block bg-emerald-600 text-white text-[9px] font-extrabold px-1.5 py-0.5 rounded uppercase">
                  100% Original BPOM
                </span>
                <p class="font-extrabold text-neutral-900 text-xs sm:text-sm leading-tight mt-0.5">
                  Pinck Smile Duo Care
                </p>
                <p class="text-[10px] text-neutral-600 leading-tight">
                  Wash 150ml + Mist 60ml
                </p>
              </div>
            </div>
          </div>

          <!-- Bottom Dark Red 7X Banner -->
          <div class="w-full bg-[#8B0000] border-t-4 border-white/20 px-4 sm:px-7 py-4 sm:py-5 flex items-center gap-3 sm:gap-5 text-left">
            <span class="font-black-display text-[#FFEA00] text-5xl sm:text-7xl leading-none text-stroke-black shrink-0">
