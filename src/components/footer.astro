---
import Container from "@/components/container.astro";
---

<footer id="tentang" class="bg-[#29242A] text-white pt-16 pb-12 border-t border-[#3A333B]">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-[#433B45]">
      
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="inline-block">
          <img 
            src="/pinck-smile-logo-light.svg" 
            alt="PINCK SMILE - Female Mood Booster" 
            class="h-12 w-auto object-contain"
            width="160"
            height="52"
          />
        </a>

        <p class="text-sm text-[#A89CA5] leading-relaxed max-w-sm">
          Female intimate wellness, thoughtfully. Kami mendampingi setiap wanita untuk merangkul kesehatan tubuh dan rasa percaya diri melalui produk yang aman, lembut, dan menjaga privasi penuh.
        </p>

        <!-- Discreet Commitment Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#362F38] border border-[#4E4450] text-xs text-[#EAD8E4]">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Garansi 100% Pengemasan Polos & Privat</span>
        </div>
      </div>

      <!-- Links Column 1: Produk -->
      <div>
        <h4 class="text-xs uppercase tracking-wider font-semibold text-[#D98AAF] mb-4">
          Produk
        </h4>
        <ul class="space-y-2.5 text-sm text-[#C8BDC5]">
          <li><a href="/pricing" class="hover:text-white transition-colors">Semua Paket & Katalog</a></li>
          <li><a href="/#produk" class="hover:text-white transition-colors">Gentle Intimate Wash</a></li>
          <li><a href="/#produk" class="hover:text-white transition-colors">Soothing Hydrating Mist</a></li>
          <li><a href="/#produk" class="hover:text-white transition-colors">Aura Intimate Device</a></li>
        </ul>
      </div>

      <!-- Links Column 2: Wellness & Edukasi -->
      <div>
        <h4 class="text-xs uppercase tracking-wider font-semibold text-[#D98AAF] mb-4">
          Edukasi & Nilai
        </h4>
        <ul class="space-y-2.5 text-sm text-[#C8BDC5]">
          <li><a href="/about" class="hover:text-white transition-colors">Tentang PINCK SMILE</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">Jurnal & Artikel Edukasi</a></li>
          <li><a href="/#intimate-wellness" class="hover:text-white transition-colors">3 Pilar Intimate Wellness</a></li>
          <li><a href="/#faq" class="hover:text-white transition-colors">FAQ & Tanya Jawab</a></li>
        </ul>
      </div>

      <!-- Links Column 3: Toko Resmi & Layanan -->
      <div>
        <h4 class="text-xs uppercase tracking-wider font-semibold text-[#D98AAF] mb-4">
          Layanan & Kontak
        </h4>
        <ul class="space-y-2.5 text-sm text-[#C8BDC5]">
          <li><a href="/contact" class="hover:text-white transition-colors">Konsultasi Privat</a></li>
          <li><a href="https://shopee.co.id" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Shopee Official</a></li>
          <li><a href="https://tokopedia.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Tokopedia Mall</a></li>
          <li><a href="https://wa.me" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">WhatsApp Concierge</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Disclaimer -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-[#8E828B]">
      <p>
        © {new Date().getFullYear()} PINCK SMILE. All rights reserved. Female Intimate Wellness.
      </p>
      <div class="flex items-center gap-6">
        <a href="/about" class="hover:text-[#D98AAF] transition-colors">Tentang Kami</a>
        <a href="/#faq" class="hover:text-[#D98AAF] transition-colors">Kebijakan Privasi & Discreet</a>
        <a href="/contact" class="hover:text-[#D98AAF] transition-colors">Pusat Bantuan</a>
      </div>
    </div>
  </Container>
</footer>
