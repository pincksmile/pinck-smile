---
import Container from "@/components/container.astro";
---

<section id="quiz-routine" class="py-20 bg-gradient-to-b from-white via-[#FFF7FB]/80 to-white border-b border-[#F5E6EF]">
  <Container>
    <div class="max-w-3xl mx-auto bg-white rounded-3xl p-8 sm:p-12 border border-[#F0D5E4] shadow-sm relative overflow-hidden">
      <!-- Decorative background accent -->
      <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-[#FFE5F7] opacity-60 blur-2xl pointer-events-none"></div>

      <!-- Quiz Header -->
      <div class="text-center max-w-xl mx-auto mb-10">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FFF7FB] border border-[#F0D5E4] text-xs font-semibold tracking-wider text-[#D98AAF] uppercase mb-3">
          Interactive Routine Finder
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-semibold text-[#29242A]">
          Temukan Ritual Perawatan Intim Anda
        </h2>
        <p class="text-xs sm:text-sm text-[#756B72] mt-2 leading-relaxed">
          Jawab 3 pertanyaan singkat untuk mendapatkan rekomendasi produk yang dirancang khusus untuk kebutuhan tubuh Anda.
        </p>
      </div>

      <!-- Quiz Interactive Wizard Container -->
      <div id="quiz-wizard">
        
        <!-- Progress Bar -->
        <div class="mb-8">
          <div class="flex justify-between text-[11px] font-semibold text-[#756B72] mb-2">
            <span id="quiz-step-indicator">Langkah 1 dari 3</span>
            <span id="quiz-step-percent" class="text-[#D98AAF]">33%</span>
          </div>
          <div class="w-full h-2 bg-[#FFF7FB] rounded-full overflow-hidden border border-[#F0D5E4]">
            <div id="quiz-progress-bar" class="h-full bg-[#D98AAF] rounded-full transition-all duration-300 w-1/3"></div>
          </div>
        </div>

        <!-- Question 1 -->
        <div id="quiz-step-1" class="quiz-step space-y-4">
          <h3 class="font-serif text-lg sm:text-xl font-semibold text-[#29242A]">
            1. Apa fokus utama perawatan intim Anda saat ini?
          </h3>
          <div class="grid sm:grid-cols-3 gap-3">
            <button
              type="button"
              onclick="window.selectQuizAnswer(1, 'daily')"
              class="quiz-option-btn text-left p-4 rounded-2xl border border-[#F0D5E4] bg-[#FFF7FB] hover:bg-[#FFE5F7] hover:border-[#D98AAF] transition-all flex flex-col justify-between group">
              <span class="text-2xl mb-2">🌿</span>
              <div>
                <strong class="block text-xs text-[#29242A] font-semibold mb-1">Perawatan Harian</strong>
                <span class="text-[11px] text-[#756B72] leading-snug">Menjaga pH 4.0 seimbang & kesegaran mikrobiom</span>
              </div>
            </button>

            <button
              type="button"
              onclick="window.selectQuizAnswer(1, 'active')"
              class="quiz-option-btn text-left p-4 rounded-2xl border border-[#F0D5E4] bg-[#FFF7FB] hover:bg-[#FFE5F7] hover:border-[#D98AAF] transition-all flex flex-col justify-between group">
              <span class="text-2xl mb-2">🌸</span>
              <div>
                <strong class="block text-xs text-[#29242A] font-semibold mb-1">On-The-Go & Olahraga</strong>
                <span class="text-[11px] text-[#756B72] leading-snug">Hidrasi cepat saat bepergian & pasca-aktivitas</span>
              </div>
            </button>

            <button
              type="button"
              onclick="window.selectQuizAnswer(1, 'intimacy')"
              class="quiz-option-btn text-left p-4 rounded-2xl border border-[#F0D5E4] bg-[#FFF7FB] hover:bg-[#FFE5F7] hover:border-[#D98AAF] transition-all flex flex-col justify-between group">
              <span class="text-2xl mb-2">✨</span>
              <div>
                <strong class="block text-xs text-[#29242A] font-semibold mb-1">Relaksasi & Keintiman</strong>
                <span class="text-[11px] text-[#756B72] leading-snug">Kesehatan otot panggul & kenyamanan intim</span>
              </div>
            </button>
          </div>
        </div>

        <!-- Question 2 -->
        <div id="quiz-step-2" class="quiz-step space-y-4 hidden">
          <h3 class="font-serif text-lg sm:text-xl font-semibold text-[#29242A]">
            2. Bagaimana kondisi kepekaan kulit area intim Anda?
          </h3>
          <div class="grid sm:grid-cols-3 gap-3">
            <button
              type="button"
              onclick="window.selectQuizAnswer(2, 'sensitive')"
              class="quiz-option-btn text-left p-4 rounded-2xl border border-[#F0D5E4] bg-[#FFF7FB] hover:bg-[#FFE5F7] hover:border-[#D98AAF] transition-all flex flex-col justify-between group">
              <span class="text-2xl mb-2">💧</span>
              <div>
                <strong class="block text-xs text-[#29242A] font-semibold mb-1">Cenderung Sensitif</strong>
                <span class="text-[11px] text-[#756B72] leading-snug">Mudah iritasi terhadap sabun biasa</span>
              </div>
            </button>

            <button
              type="button"
              onclick="window.selectQuizAnswer(2, 'normal')"
              class="quiz-option-btn text-left p-4 rounded-2xl border border-[#F0D5E4] bg-[#FFF7FB] hover:bg-[#FFE5F7] hover:border-[#D98AAF] transition-all flex flex-col justify-between group">
              <span class="text-2xl mb-2">☁️</span>
              <div>
                <strong class="block text-xs text-[#29242A] font-semibold mb-1">Normal & Seimbang</strong>
                <span class="text-[11px] text-[#756B72] leading-snug">Ingin perlindungan preventif berkualitas</span>
              </div>
            </button>

            <button
              type="button"
              onclick="window.selectQuizAnswer(2, 'post-shave')"
              class="quiz-option-btn text-left p-4 rounded-2xl border border-[#F0D5E4] bg-[#FFF7FB] hover:bg-[#FFE5F7] hover:border-[#D98AAF] transition-all flex flex-col justify-between group">
              <span class="text-2xl mb-2">🍃</span>
              <div>
                <strong class="block text-xs text-[#29242A] font-semibold mb-1">Sering Dicukur / Waxing</strong>
                <span class="text-[11px] text-[#756B72] leading-snug">Membutuhkan hidrasi penenang & anti-kemerahan</span>
              </div>
            </button>
          </div>
        </div>

        <!-- Question 3 -->
        <div id="quiz-step-3" class="quiz-step space-y-4 hidden">
          <h3 class="font-serif text-lg sm:text-xl font-semibold text-[#29242A]">
            3. Bentuk format perawatan yang paling Anda sukai?
          </h3>
          <div class="grid sm:grid-cols-3 gap-3">
            <button
              type="button"
              onclick="window.selectQuizAnswer(3, 'wash')"
              class="quiz-option-btn text-left p-4 rounded-2xl border border-[#F0D5E4] bg-[#FFF7FB] hover:bg-[#FFE5F7] hover:border-[#D98AAF] transition-all flex flex-col justify-between group">
              <span class="text-2xl mb-2">🫧</span>
              <div>
                <strong class="block text-xs text-[#29242A] font-semibold mb-1">Pembersih Busa Lembut</strong>
                <span class="text-[11px] text-[#756B72] leading-snug">Digunakan saat mandi pagi/malam</span>
              </div>
            </button>

            <button
              type="button"
              onclick="window.selectQuizAnswer(3, 'mist')"
              class="quiz-option-btn text-left p-4 rounded-2xl border border-[#F0D5E4] bg-[#FFF7FB] hover:bg-[#FFE5F7] hover:border-[#D98AAF] transition-all flex flex-col justify-between group">
              <span class="text-2xl mb-2">💦</span>
              <div>
                <strong class="block text-xs text-[#29242A] font-semibold mb-1">Spray Mist Tanpa Bilas</strong>
                <span class="text-[11px] text-[#756B72] leading-snug">Cepat, praktis, dan dapat dibawa kemana saja</span>
              </div>
            </button>

            <button
              type="button"
              onclick="window.selectQuizAnswer(3, 'set')"
              class="quiz-option-btn text-left p-4 rounded-2xl border border-[#F0D5E4] bg-[#FFF7FB] hover:bg-[#FFE5F7] hover:border-[#D98AAF] transition-all flex flex-col justify-between group">
              <span class="text-2xl mb-2">🎁</span>
              <div>
                <strong class="block text-xs text-[#29242A] font-semibold mb-1">Paket Perawatan Menyeluruh</strong>
                <span class="text-[11px] text-[#756B72] leading-snug">Solusi lengkap untuk hasil optimal</span>
              </div>
            </button>
          </div>
        </div>

        <!-- Result Screen -->
        <div id="quiz-result" class="quiz-step text-center space-y-6 hidden">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold border border-emerald-200">
            ✓ Rekomendasi Khusus Selesai
          </div>

          <div class="bg-[#FFF7FB] rounded-3xl p-6 border border-[#F0D5E4] max-w-md mx-auto space-y-4">
            <div class="w-16 h-16 rounded-2xl bg-white border border-[#F0D5E4] flex items-center justify-center text-3xl mx-auto shadow-xs">
              🌸
            </div>
            
            <div>
              <span id="result-category" class="text-[10px] uppercase font-bold tracking-widest text-[#D98AAF]">
                Rekomendasi Utama
              </span>
              <h4 id="result-title" class="font-serif text-xl font-semibold text-[#29242A] mt-1">
                Pinck Smile Gentle Intimate Wash
              </h4>
              <p id="result-desc" class="text-xs text-[#756B72] mt-2 leading-relaxed">
                Formula pH 4.0 dengan Chamomile dan Prebiotic sangat cocok untuk kebutuhan kulit sensitif dan perawatan harian Anda.
              </p>
              <div id="result-price" class="text-lg font-bold text-[#29242A] mt-3">
                Rp 149.000
              </div>
            </div>

            <div class="pt-4 border-t border-[#F0D5E4] flex flex-col sm:flex-row gap-2">
              <button
                id="result-add-btn"
                class="flex-1 py-3 rounded-full bg-[#D98AAF] text-white text-xs font-semibold hover:bg-[#C6759B] transition-colors shadow-sm">
                Tambahkan ke Tas Belanja
              </button>
              <button
                onclick="window.resetQuiz()"
                class="px-4 py-3 rounded-full bg-white border border-[#F0D5E4] text-xs font-semibold text-[#756B72] hover:bg-[#FFE5F7] transition-colors">
                Ulangi
              </button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </Container>
</section>

<script is:inline>
  (function () {
    let answers = {};

    window.selectQuizAnswer = function (step, value) {
      answers[step] = value;

      if (step === 1) {
        document.getElementById("quiz-step-1")?.classList.add("hidden");
        document.getElementById("quiz-step-2")?.classList.remove("hidden");
        document.getElementById("quiz-step-indicator").textContent = "Langkah 2 dari 3";
        document.getElementById("quiz-step-percent").textContent = "66%";
        document.getElementById("quiz-progress-bar").style.width = "66%";
      } else if (step === 2) {
        document.getElementById("quiz-step-2")?.classList.add("hidden");
        document.getElementById("quiz-step-3")?.classList.remove("hidden");
        document.getElementById("quiz-step-indicator").textContent = "Langkah 3 dari 3";
        document.getElementById("quiz-step-percent").textContent = "100%";
        document.getElementById("quiz-progress-bar").style.width = "100%";
      } else if (step === 3) {
        showResult();
      }
    };

    function showResult() {
      document.getElementById("quiz-step-3")?.classList.add("hidden");
      document.getElementById("quiz-result")?.classList.remove("hidden");

      let prodName = "Pinck Smile Gentle Intimate Wash";
      let prodId = "gentle-wash";
      let prodPrice = 149000;
      let prodDesc = "Formula pH 4.0 dengan Chamomile dan Prebiotic sangat cocok untuk menyeimbangkan flora dan pelindung alami kewanitaan.";

      if (answers[1] === "active" || answers[3] === "mist") {
        prodName = "Pinck Smile Soothing Hydrating Mist";
        prodId = "soothing-mist";
        prodPrice = 129000;
        prodDesc = "Mist praktis tanpa bilas dengan Rosewater & Hyaluronic Acid memberikan hidrasi instan dan menenangkan kulit seketika saat aktif.";
      } else if (answers[1] === "intimacy") {
        prodName = "Pinck Smile Aura Intimate Device";
        prodId = "wellness-device";
        prodPrice = 489000;
        prodDesc = "Perangkat berbahan silikon medis 100% tahan air untuk relaksasi otot panggul, eksplorasi tubuh yang sehat, dan kenyamanan intim maksimal.";
      } else if (answers[3] === "set") {
        prodName = "Complete Comfort Set";
        prodId = "complete-set";
        prodPrice = 259000;
        prodDesc = "Kombinasi lengkap Gentle Intimate Wash + Hydrating Mist untuk perawatan rumah dan bepergian.";
      }

      const titleEl = document.getElementById("result-title");
      const descEl = document.getElementById("result-desc");
      const priceEl = document.getElementById("result-price");
      const addBtn = document.getElementById("result-add-btn");

      if (titleEl) titleEl.textContent = prodName;
      if (descEl) descEl.textContent = prodDesc;
      if (priceEl) priceEl.textContent = `Rp ${prodPrice.toLocaleString("id-ID")}`;

      if (addBtn) {
        addBtn.onclick = function () {
          if (window.addToCart) {
            window.addToCart(prodId, prodName, prodPrice);
          }
        };
      }
    }

    window.resetQuiz = function () {
      answers = {};
      document.getElementById("quiz-result")?.classList.add("hidden");
      document.getElementById("quiz-step-1")?.classList.remove("hidden");
      document.getElementById("quiz-step-indicator").textContent = "Langkah 1 dari 3";
      document.getElementById("quiz-step-percent").textContent = "33%";
      document.getElementById("quiz-progress-bar").style.width = "33%";
    };
  })();
</script>
