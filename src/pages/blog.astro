---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";

// Filter blog entries with 'draft: false'
const publishedBlogEntries = await getCollection("blog", ({ data }) => {
  return !data.draft;
});

// Sort content entries by publication date
publishedBlogEntries.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});

const categories = ["Semua", "Kesehatan Seksual", "Edukasi & Sains", "Confidence & Self-Care", "Relationship & Intimacy"];

const siteUrl = "https://pinck-smile.netlify.app";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Jurnal & Edukasi",
      "item": `${siteUrl}/blog`
    }
  ]
};
---

<Layout 
  title="Edukasi & Jurnal Intimate Wellness - PINCK SMILE (Pink Smile)"
  description="Wawasan ilmiah, panduan perawatan pH seimbang, body literacy, dan tips keintiman sehat dari para ahli dan tim editorial PINCK SMILE (Pink Smile)."
  jsonLd={[breadcrumbSchema]}>
  <Container class="py-16">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <p class="text-xs font-semibold tracking-widest text-[#D98AAF] uppercase mb-3">
        Edukasi & Artikel
      </p>
      <h1 class="text-4xl sm:text-5xl font-serif font-semibold text-[#29242A] text-balance">
        Jurnal PINCK SMILE
      </h1>
      <p class="text-base text-[#756B72] mt-4 leading-relaxed">
        Wawasan seputar kesehatan reproduksi, kenyamanan intim, kepercayaan diri, dan keharmonisan hubungan.
      </p>
    </div>

    <!-- Interactive Search & Category Filter Toolbar -->
    <div class="max-w-5xl mx-auto mb-10 space-y-4">
      <!-- Search Input -->
      <div class="relative">
        <input
          type="text"
          id="article-search-input"
          placeholder="Cari topik artikel (contoh: pH seimbang, body literacy, mikrobiom)..."
          class="w-full pl-11 pr-4 py-3.5 rounded-2xl border border-[#F0D5E4] bg-white text-xs text-[#29242A] focus:outline-none focus:border-[#D98AAF] shadow-xs"
        />
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5 text-[#756B72] absolute left-3.5 top-1/2 -translate-y-1/2"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
        {
          categories.map((cat, idx) => (
            <button
              type="button"
              data-category={cat}
              class={`filter-category-btn px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap shrink-0 transition-all border ${
                idx === 0
                  ? "bg-[#D98AAF] text-white border-[#D98AAF] shadow-xs"
                  : "bg-[#FFF7FB] text-[#756B72] border-[#F0D5E4] hover:bg-[#FFE5F7] hover:text-[#29242A]"
              }`}>
              {cat}
            </button>
          ))
        }
      </div>
    </div>

    <main class="max-w-5xl mx-auto">
      <div id="articles-container" class="grid md:grid-cols-2 gap-8">
        {
          publishedBlogEntries.map((blogPostEntry) => (
            <article 
              data-category={blogPostEntry.data.category}
              data-title={blogPostEntry.data.title.toLowerCase()}
              data-snippet={blogPostEntry.data.snippet.toLowerCase()}
              class="article-card bg-white rounded-3xl overflow-hidden border border-[#F0D5E4] shadow-xs brand-card-hover group transition-all duration-300 flex flex-col justify-between">
              <a href={`/blog/${blogPostEntry.slug}`} class="flex flex-col h-full justify-between">
                <div>
                  <!-- Article Thumbnail -->
                  <div class="w-full aspect-[16/9] bg-gradient-to-br from-[#FFF7FB] via-[#FFE5F7] to-[#F5E6EF] relative overflow-hidden border-b border-[#F0D5E4]">
                    <img
                      src={blogPostEntry.data.image.src}
                      alt={blogPostEntry.data.image.alt}
                      loading="lazy"
                      referrerpolicy="no-referrer"
                      onerror="this.style.display='none'"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out relative z-10"
                    />
                    <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center z-0">
                      <span class="text-3xl text-[#D98AAF] font-serif mb-1">✦</span>
                      <span class="text-xs font-serif text-[#756B72] line-clamp-1">{blogPostEntry.data.title}</span>
                    </div>
                  </div>

                  <!-- Article Body -->
                  <div class="p-6 sm:p-7">
                    <div class="flex items-center gap-2 text-xs text-[#756B72] mb-3">
                      <span class="font-semibold text-[#D98AAF]">
                        {blogPostEntry.data.category}
                      </span>
                      <span aria-hidden="true">·</span>
                      <time datetime={blogPostEntry.data.publishDate.toISOString()}>
                        {blogPostEntry.data.publishDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}
                      </time>
                    </div>

                    <h2 class="text-xl sm:text-2xl font-serif font-semibold text-[#29242A] group-hover:text-[#D98AAF] transition-colors leading-snug mb-3 text-balance">
                      {blogPostEntry.data.title}
                    </h2>

                    <p class="text-sm text-[#756B72] leading-relaxed line-clamp-3">
                      {blogPostEntry.data.snippet}
                    </p>
                  </div>
                </div>

                <div class="px-6 sm:px-7 pb-6 pt-4 border-t border-[#F5E6EF] flex items-center justify-between text-xs font-medium text-[#756B72]">
                  <span>Penulis: {blogPostEntry.data.author}</span>
                  <span class="text-[#D98AAF] font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 whitespace-nowrap shrink-0">
                    Baca Selengkapnya →
                  </span>
                </div>
              </a>
            </article>
          ))
        }
      </div>

      <!-- Empty Filter State -->
      <div id="no-articles-found" class="hidden text-center py-16 bg-[#FFF7FB] rounded-3xl border border-[#F0D5E4] p-8">
        <div class="text-3xl mb-2">🔍</div>
        <h3 class="font-serif text-lg font-semibold text-[#29242A]">Artikel Tidak Ditemukan</h3>
        <p class="text-xs text-[#756B72] mt-1">Coba gunakan kata kunci pencarian yang lain atau pilih kategori Semua.</p>
      </div>
    </main>
  </Container>
</Layout>

<script is:inline>
  (function () {
    const searchInput = document.getElementById("article-search-input");
    const filterBtns = document.querySelectorAll(".filter-category-btn");
    const articles = document.querySelectorAll(".article-card");
    const noArticlesMsg = document.getElementById("no-articles-found");

    let currentCategory = "Semua";
    let searchQuery = "";

    function filterArticles() {
      let visibleCount = 0;

      articles.forEach((card) => {
        const cat = card.getAttribute("data-category");
        const title = card.getAttribute("data-title") || "";
        const snippet = card.getAttribute("data-snippet") || "";

        const matchesCat = currentCategory === "Semua" || cat === currentCategory;
        const matchesQuery = !searchQuery || title.includes(searchQuery) || snippet.includes(searchQuery);

        if (matchesCat && matchesQuery) {
          card.style.display = "flex";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      if (noArticlesMsg) {
        if (visibleCount === 0) {
          noArticlesMsg.classList.remove("hidden");
        } else {
          noArticlesMsg.classList.add("hidden");
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        filterArticles();
      });
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterBtns.forEach((b) => {
          b.className = "filter-category-btn px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all border bg-[#FFF7FB] text-[#756B72] border-[#F0D5E4] hover:bg-[#FFE5F7] hover:text-[#29242A]";
        });
        btn.className = "filter-category-btn px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all border bg-[#D98AAF] text-white border-[#D98AAF] shadow-xs";

        currentCategory = btn.getAttribute("data-category");
        filterArticles();
      });
    });
  })();
</script>
