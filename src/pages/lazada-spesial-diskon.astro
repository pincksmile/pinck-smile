---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
---

<Layout
  title="Lazada Spesial Diskon & Promo 11.11 — PINCK SMILE Official"
  description="Nikmati Lazada Spesial Diskon & Promo 11.11 Terbesar Tahun Ini dari PINCK SMILE. Dapatkan voucher belanja, bonus dadakan, gratis ongkir, dan penawaran eksklusif khusus hari ini."
  canonicalPath="/lazada-spesial-diskon">
  
  <main class="bg-[#FAF6F0] py-12 text-[#29242A]">
    <Container class="max-w-4xl mx-auto">
      
      <!-- Top Header Badge -->
      <div class="text-center mb-8">
        <span class="inline-block bg-[#0F146D] text-white text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider mb-3 shadow-xs">
          Lazada Spesial Diskon • Promo 11.11 Diskon Terbesar
        </span>
        <h1 class="text-3xl sm:text-5xl font-serif font-semibold text-[#29242A] leading-tight">
          Lazada Spesial Diskon &amp; Penawaran Eksklusif 11.11
        </h1>
        <p class="text-sm sm:text-base text-[#756B72] mt-3 max-w-2xl mx-auto leading-relaxed">
          Selamat datang di halaman resmi promo kolaborasi Lazada PINCK SMILE. Dapatkan diskon spesial, voucher toko, bonus dadakan, dan Free Shipping Max untuk seluruh produk perawatan intim terbaik.
        </p>
      </div>

      <!-- Store Deco & PDP Banner Showcase -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-xl border border-[#F0D5E4] space-y-6">
        
        <!-- Store Deco Banners -->
        <div>
          <h2 class="text-xs uppercase tracking-wider font-bold text-[#0F146D] mb-3">
            ✨ Store Decoration &amp; Voucher Spesial 11.11
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="rounded-2xl overflow-hidden border border-neutral-200 shadow-sm bg-neutral-50 p-2">
              <img
                src="/assets/Banner%20Spesial/Store%20Deco/D-Day.png"
                alt="Lazada 11.11 D-Day"
                class="w-full h-auto rounded-xl object-contain"
                loading="eager"
              />
            </div>
            <div class="rounded-2xl overflow-hidden border border-neutral-200 shadow-sm bg-neutral-50 p-2">
              <img
                src="/assets/Banner%20Spesial/Store%20Deco/Bonus%20Dadakan.png"
                alt="Bonus Dadakan Lazada"
                class="w-full h-auto rounded-xl object-contain"
                loading="eager"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-3">
            <div class="rounded-xl overflow-hidden border border-neutral-200 shadow-sm p-1.5 bg-neutral-50">
              <img src="/assets/Banner%20Spesial/Store%20Deco/Kumpulkan%20Voucher.png" alt="Kumpulkan Voucher" class="w-full h-auto rounded-lg" loading="lazy" />
            </div>
            <div class="rounded-xl overflow-hidden border border-neutral-200 shadow-sm p-1.5 bg-neutral-50">
              <img src="/assets/Banner%20Spesial/Store%20Deco/Flexi%20Combo.png" alt="Flexi Combo" class="w-full h-auto rounded-lg" loading="lazy" />
            </div>
            <div class="rounded-xl overflow-hidden border border-neutral-200 shadow-sm p-1.5 bg-neutral-50">
              <img src="/assets/Banner%20Spesial/Store%20Deco/Free%20Shipping%20Max.png" alt="Free Shipping Max" class="w-full h-auto rounded-lg" loading="lazy" />
            </div>
          </div>
        </div>

        <!-- PDP Product Showcase Banners -->
        <div class="pt-6 border-t border-[#F0D5E4]">
          <h2 class="text-xs uppercase tracking-wider font-bold text-[#0F146D] mb-3">
            🛍️ Penampakan Resmi Produk &amp; Store Showcase
          </h2>
          <div class="space-y-4">
            <div class="rounded-2xl overflow-hidden border border-neutral-200 shadow-sm p-2 bg-neutral-50">
              <img src="/assets/Banner%20Spesial/PDP/PDP%20Nama%20Toko.png" alt="PDP Nama Toko" class="w-full h-auto rounded-xl" loading="lazy" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="rounded-xl overflow-hidden border border-neutral-200 shadow-sm p-2 bg-neutral-50">
                <img src="/assets/Banner%20Spesial/PDP/PDP%20Produk.png" alt="PDP Produk" class="w-full h-auto rounded-lg" loading="lazy" />
              </div>
              <div class="rounded-xl overflow-hidden border border-neutral-200 shadow-sm p-2 bg-neutral-50">
                <img src="/assets/Banner%20Spesial/PDP/PDP%20General.png" alt="PDP General" class="w-full h-auto rounded-lg" loading="lazy" />
              </div>
            </div>
            <div class="rounded-xl overflow-hidden border border-neutral-200 shadow-sm p-2 bg-neutral-50">
              <img src="/assets/Banner%20Spesial/PDP/General%20New%20Size.png" alt="General New Size" class="w-full h-auto rounded-lg" loading="lazy" />
            </div>
          </div>
        </div>

        <!-- Direct Action / Checkout Buttons -->
        <div class="pt-6 border-t border-[#F0D5E4] text-center space-y-4">
          <h3 class="font-serif text-xl font-semibold text-[#29242A]">
            Ambil Promo Lazada Spesial Diskon Sekarang!
          </h3>
          <p class="text-xs text-[#756B72] max-w-md mx-auto">
            Kunjungi Lazada Official Store kami untuk mengklaim seluruh voucher diskon 11.11 dan gratis ongkir, atau pesan langsung melalui WhatsApp Concierge kami.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
            <a
              href="https://share.google/nJK2B7iDNKitHambl"
              target="_blank"
              rel="noopener noreferrer"
              class="px-8 py-3.5 rounded-full bg-[#0F146D] hover:bg-[#090C49] text-white font-bold text-xs sm:text-sm shadow-md transition-all flex items-center gap-2">
              <span>Buka Lazada Official Store ↗</span>
            </a>
            <a
              href="https://wa.me/6288980874055?text=Halo%20PINCK%20SMILE%2C%20saya%20melihat%20halaman%20Lazada%20Spesial%20Diskon%2011.11%20dan%20ingin%20memesan%20produk%20dengan%20harga%20promo%20spesial."
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs sm:text-sm shadow-md transition-all flex items-center gap-2">
              <span>Pesan via WhatsApp (Bisa COD) 💬</span>
            </a>
          </div>
        </div>

      </div>

    </Container>
  </main>
</Layout>
