---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";

// Generate a new path for every collection entry
export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get the entry directly from the prop on render
const { entry } = Astro.props;
const { Content } = await entry.render();

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://pinck-smile.netlify.app";
const pageUrl = `${siteUrl}/blog/${entry.slug}`;

// Get all published blog entries for related posts recommendation
const allPosts = await getCollection("blog", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});

const relatedPosts = allPosts
  .filter((p) => p.slug !== entry.slug)
  .sort((a, b) => {
    const aMatch = a.data.category === entry.data.category ? 1 : 0;
    const bMatch = b.data.category === entry.data.category ? 1 : 0;
    if (bMatch !== aMatch) return bMatch - aMatch;
    return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
  })
  .slice(0, 3);

// Products catalog for in-article showcase
const featuredProducts = [
  {
    id: "gentle-wash",
    slug: "gentle-intimate-wash",
    name: "Pinck Smile Gentle Intimate Wash",
    category: "Daily Balance Cleanser (pH 4.0)",
    priceNum: 149000,
    priceStr: "Rp 149.000",
    volume: "150 ml",
    description: "Pembersih ultra-lembut pH 4.0 dengan Chamomile & Prebiotik untuk menjaga mikrobiom alami.",
    badge: "Best Seller",
  },
  {
    id: "soothing-mist",
    slug: "soothing-hydrating-mist",
    name: "Pinck Smile Soothing Hydrating Mist",
    category: "Instant Refresh & Barrier Defense",
    priceNum: 129000,
    priceStr: "Rp 129.000",
    volume: "60 ml",
    description: "Mist tanpa bilas dengan Rosewater & Niacinamide untuk hidrasi instan kapan pun dibutuhkan.",
    badge: "Staff Pick",
  },
  {
    id: "wellness-device",
    slug: "aura-intimate-device",
    name: "Pinck Smile Aura Intimate Device",
    category: "Wellness & Sensual Relaxation",
    priceNum: 489000,
    priceStr: "Rp 489.000",
    volume: "Medical Silicone",
    description: "Perangkat relaksasi otot panggul & stimulasi berfrekuensi mikro dengan silikon medis ultra-senyap.",
    badge: "Signature",
  },
];

// Article Schema JSON-LD
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": entry.data.title,
  "description": entry.data.snippet,
  "image": entry.data.image.src,
  "datePublished": entry.data.publishDate.toISOString(),
  "dateModified": entry.data.publishDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": entry.data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "PINCK SMILE",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/favicon.svg`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": pageUrl
  }
};

// Breadcrumbs Schema JSON-LD
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Jurnal & Edukasi",
      "item": `${siteUrl}/blog`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": entry.data.title,
      "item": pageUrl
    }
  ]
};
---

<Layout 
  title={`${entry.data.title} - Jurnal PINCK SMILE`}
  description={entry.data.snippet}
  image={entry.data.image.src}
  article={{
    publishedTime: entry.data.publishDate.toISOString(),
    authors: [entry.data.author],
    section: entry.data.category,
    tags: entry.data.tags,
  }}
  jsonLd={[articleSchema, breadcrumbSchema]}>
  
  <Container class="py-12">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs text-[#756B72] max-w-3xl mx-auto mb-8">
      <a href="/" class="hover:text-[#D98AAF] transition-colors">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-[#D98AAF] transition-colors">Jurnal</a>
      <span>/</span>
      <span class="text-[#29242A] truncate max-w-[200px] sm:max-w-none">{entry.data.category}</span>
    </nav>

    <!-- Article Header -->
    <header class="mx-auto max-w-3xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FFF7FB] border border-[#F0D5E4] text-xs font-semibold tracking-wider text-[#D98AAF] uppercase mb-4">
        {entry.data.category}
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-semibold text-[#29242A] leading-[1.2] mb-6">
        {entry.data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-xs text-[#756B72] pb-6 border-b border-[#F0D5E4]">
        <div class="flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-[#FFE5F7] text-[#D98AAF] flex items-center justify-center font-bold text-[10px]">
            PS
          </span>
          <span class="font-medium text-[#29242A]">{entry.data.author}</span>
        </div>
        <span>•</span>
        <time datetime={entry.data.publishDate.toISOString()}>
          {entry.data.publishDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span>•</span>
        <div class="flex flex-wrap gap-1.5">
          {
            entry.data.tags.map((tag) => (
              <span class="px-2 py-0.5 rounded-full bg-[#FFF7FB] border border-[#F0D5E4] text-[11px] text-[#756B72]">
                #{tag}
              </span>
            ))
          }
        </div>
      </div>
    </header>

    <!-- Featured Image -->
    <div class="mx-auto max-w-3xl mb-12 rounded-3xl overflow-hidden shadow-md border border-[#F0D5E4]">
      <img
        src={entry.data.image.src}
        alt={entry.data.image.alt}
        loading="eager"
        class="w-full aspect-[16/9] object-cover"
      />
    </div>

    <!-- Article Body -->
    <article class="mx-auto prose prose-lg prose-pink max-w-3xl text-[#29242A] leading-relaxed prose-headings:font-serif prose-headings:text-[#29242A] prose-a:text-[#D98AAF] hover:prose-a:text-[#C6759B] prose-img:rounded-2xl">
      <Content />
    </article>

    <!-- Discreet Commitment Micro-Banner -->
    <div class="max-w-3xl mx-auto my-14 bg-[#FFF7FB] rounded-2xl p-6 border border-[#F0D5E4] flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-[#FFE5F7] text-[#D98AAF] flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <div>
          <h4 class="text-xs font-semibold text-[#29242A]">100% Discreet Packaging & Fast Support</h4>
          <p class="text-xs text-[#756B72]">Semua pesanan dikirim dalam kardus polos tanpa label nama produk demi menjaga privasi penuh Anda.</p>
        </div>
      </div>
      <a
        href="https://wa.me/6288980874055?text=Halo%20PINCK%20SMILE%2C%20saya%20ingin%20konsultasi%20mengenai%20produk."
        target="_blank"
        rel="noopener noreferrer"
        class="whitespace-nowrap px-4 py-2 rounded-full bg-[#29242A] text-white text-xs font-semibold hover:bg-[#D98AAF] transition-colors shrink-0">
        Konsultasi WhatsApp
      </a>
    </div>

    <!-- IN-ARTICLE PRODUCT SHOWCASE SECTION -->
    <section class="max-w-3xl mx-auto my-16 pt-12 border-t border-[#F0D5E4]">
      <div class="text-center mb-8">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FFF7FB] border border-[#F0D5E4] text-[11px] font-semibold tracking-wider text-[#D98AAF] uppercase mb-2">
          ✦ Rekomendasi Produk Terkait
        </div>
        <h3 class="text-2xl sm:text-3xl font-serif font-semibold text-[#29242A]">
          Koleksi Perawatan Intim PINCK SMILE
        </h3>
        <p class="text-xs sm:text-sm text-[#756B72] mt-1 max-w-md mx-auto">
          Diformulasikan secara lembut dengan standar medis untuk mendukung kenyamanan, kebersihan, dan relaksasi alami.
        </p>
      </div>

      <div class="grid sm:grid-cols-3 gap-5">
        {
          featuredProducts.map((p) => (
            <div class="bg-white rounded-2xl p-5 border border-[#F0D5E4] shadow-xs flex flex-col justify-between hover:shadow-md transition-shadow">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-[10px] font-semibold uppercase tracking-wider text-[#D98AAF] bg-[#FFF7FB] px-2 py-0.5 rounded-full border border-[#F0D5E4]">
                    {p.badge}
                  </span>
                  <span class="text-[10px] text-[#756B72]">{p.volume}</span>
                </div>

                <h4 class="font-serif font-semibold text-sm text-[#29242A] hover:text-[#D98AAF] transition-colors leading-snug mb-1">
                  <a href={`/products/${p.slug}`}>
                    {p.name}
                  </a>
                </h4>
                
                <p class="text-[11px] text-[#756B72] leading-relaxed mb-3 line-clamp-2">
                  {p.description}
                </p>
              </div>

              <div class="pt-3 border-t border-[#F5E6EF] space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-serif font-bold text-[#D98AAF]">
                    {p.priceStr}
                  </span>
                  <a
                    href={`/products/${p.slug}`}
                    class="text-[10px] font-semibold text-[#756B72] hover:text-[#D98AAF] transition-colors">
                    Detail →
                  </a>
                </div>

                <button
                  type="button"
                  data-id={p.id}
                  data-name={p.name}
                  data-price={p.priceNum}
                  data-category={p.category}
                  class="add-to-cart-btn w-full py-2 px-3 rounded-full bg-[#29242A] text-white text-[11px] font-semibold hover:bg-[#D98AAF] transition-colors flex items-center justify-center gap-1.5 cursor-pointer">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                  </svg>
                  <span>+ Tambah ke Tas</span>
                </button>
              </div>
            </div>
          ))
        }
      </div>

      <div class="text-center mt-6">
        <a
          href="/pricing"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#D98AAF] hover:text-[#29242A] transition-colors">
          <span>Lihat Semua Paket Hemat & Koleksi Lengkap</span>
          <span>→</span>
        </a>
      </div>
    </section>

    <!-- RELATED ARTICLES SECTION -->
    {
      relatedPosts.length > 0 && (
        <section class="max-w-3xl mx-auto my-16 pt-12 border-t border-[#F0D5E4]">
          <div class="flex items-center justify-between mb-8">
            <div>
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FFF7FB] border border-[#F0D5E4] text-[11px] font-semibold tracking-wider text-[#D98AAF] uppercase mb-1">
                Edukasi Lainnya
              </div>
              <h3 class="text-2xl font-serif font-semibold text-[#29242A]">
                Artikel Terkait yang Mungkin Anda Suka
              </h3>
            </div>
            <a
              href="/blog"
              class="text-xs font-semibold text-[#D98AAF] hover:text-[#29242A] transition-colors hidden sm:inline-block">
              Semua Artikel →
            </a>
          </div>

          <div class="grid sm:grid-cols-3 gap-6">
            {
              relatedPosts.map((post) => (
                <article class="bg-[#FFF7FB] rounded-2xl p-5 border border-[#F0D5E4] brand-card-hover group flex flex-col justify-between">
                  <div>
                    <div class="flex items-center gap-2 mb-2">
                      <span class="text-[10px] font-semibold uppercase tracking-wider text-[#D98AAF] bg-white px-2 py-0.5 rounded-full border border-[#F0D5E4]">
                        {post.data.category}
                      </span>
                    </div>

                    <h4 class="font-serif font-semibold text-sm text-[#29242A] group-hover:text-[#D98AAF] transition-colors leading-snug mb-2 line-clamp-2">
                      <a href={`/blog/${post.slug}`}>
                        {post.data.title}
                      </a>
                    </h4>

                    <p class="text-[11px] text-[#756B72] leading-relaxed line-clamp-2 mb-3">
                      {post.data.snippet}
                    </p>
                  </div>

                  <div class="pt-3 border-t border-[#F0D5E4] flex items-center justify-between text-[11px]">
                    <span class="text-[#756B72]">{post.data.author}</span>
                    <a
                      href={`/blog/${post.slug}`}
                      class="text-[#D98AAF] font-semibold group-hover:translate-x-0.5 transition-transform flex items-center gap-1">
                      <span>Baca</span>
                      <span>→</span>
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </section>
      )
    }

    <!-- Bottom Navigation CTA -->
    <div class="max-w-3xl mx-auto mt-12 pt-8 border-t border-[#F0D5E4] flex flex-col sm:flex-row items-center justify-between gap-4">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#FFF7FB] border border-[#F0D5E4] text-xs font-semibold text-[#29242A] hover:bg-[#FFE5F7] transition-all duration-200">
        <span>← Kembali ke Semua Artikel</span>
      </a>

      <a
        href="/#produk"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#D98AAF] text-white text-xs font-semibold hover:bg-[#C6759B] transition-all duration-200 shadow-sm">
        <span>Beli Produk PINCK SMILE →</span>
      </a>
    </div>
  </Container>
</Layout>
