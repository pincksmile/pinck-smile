---
import { products, type Product } from "@/data/products";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import ProductVisual from "@/components/product-visual.astro";

export async function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://pinck-smile.netlify.app";
const pageUrl = `${siteUrl}/products/${product.slug}`;

// Related products
const otherProducts = products.filter((p) => p.slug !== product.slug).slice(0, 3);

// Related blog articles
const allPosts = await getCollection("blog", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});
const relatedArticles = allPosts.slice(0, 3);

// Verified reviews specific to product
const sampleReviews = [
  {
    name: "Dr. Nindya P., Sp.KK",
    location: "Jakarta Selatan",
    role: "Verified Medical Specialist",
    rating: 5,
    date: "12 Agustus 2026",
    comment: "Sebagai dokter kulit, saya sangat mengapresiasi formulasi pH seimbang tanpa sulfat keras dari PINCK SMILE. Menjaga flora alami tanpa mengikis kelembapan.",
  },
  {
    name: "Clara S.",
    location: "Surabaya",
    role: "Verified Buyer",
    rating: 5,
    date: "28 Juli 2026",
    comment: "Pengiriman sangat aman dan tertutup rapi tanpa label nama produk di kardus. Kualitas produknya premium sekali, terasa nyaman dari pemakaian pertama.",
  },
  {
    name: "Amalia R.",
    location: "Bandung",
    role: "Verified Buyer",
    rating: 5,
    date: "04 Agustus 2026",
    comment: "Sangat membantu mengatasi rasa gerah dan lembap setelah berolahraga. Aromanya botani alami, tidak menyengat sama sekali. Pasti repurchase!",
  },
];

// Schema.org Product JSON-LD
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.name,
  "description": product.shortDescription,
  "brand": {
    "@type": "Brand",
    "name": "PINCK SMILE"
  },
  "offers": {
    "@type": "Offer",
    "url": pageUrl,
    "priceCurrency": "IDR",
    "price": product.priceNum,
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": "PINCK SMILE"
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": product.rating.toString(),
    "reviewCount": product.reviewCount.toString(),
    "bestRating": "5",
    "worstRating": "1"
  }
};

// Breadcrumb Schema JSON-LD
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Produk",
      "item": `${siteUrl}/products`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": product.name,
      "item": pageUrl
    }
  ]
};
---

<Layout
  title={`${product.name} - PINCK SMILE Intimate Wellness`}
  description={product.shortDescription}
  jsonLd={[productSchema, breadcrumbSchema]}>
  
  <Container class="py-8 sm:py-12">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs text-[#756B72] mb-8 overflow-x-auto whitespace-nowrap pb-2">
      <a href="/" class="hover:text-[#D98AAF] transition-colors">Home</a>
      <span>/</span>
      <a href="/products" class="hover:text-[#D98AAF] transition-colors">Produk</a>
      <span>/</span>
      <span class="text-[#29242A] font-medium truncate">{product.name}</span>
    </nav>

    <!-- Main Product Showcase Grid -->
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-start mb-20">
      
      <!-- Visual Gallery Container (Left 6 cols) -->
      <div class="lg:col-span-6 lg:sticky lg:top-24 space-y-4">
        <div class={`w-full aspect-[4/3] sm:aspect-square rounded-3xl bg-gradient-to-br ${product.accentGradient} border border-[#F0D5E4] p-6 sm:p-10 flex flex-col justify-between relative overflow-hidden shadow-sm`}>
          
          <!-- Top Badges -->
          <div class="flex items-center justify-between z-10">
            <span class="text-xs font-semibold text-[#D98AAF] bg-white/95 backdrop-blur-xs px-3.5 py-1.5 rounded-full border border-[#F0D5E4] shadow-2xs">
              {product.category}
            </span>
            <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
              100% Original BPOM
            </span>
          </div>

          <!-- Product Visual Centerpiece -->
          <div class="my-auto py-4 flex items-center justify-center">
            <ProductVisual id={product.id} size="lg" />
          </div>

          <!-- Bottom Micro Features -->
          <div class="z-10 flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-[#F0D5E4]/60 text-[11px] text-[#756B72]">
            <span class="flex items-center gap-1 font-medium">
              <span class="text-[#D98AAF]">✓</span> 100% Discreet Shipping
            </span>
            <span class="flex items-center gap-1 font-medium">
              <span class="text-[#D98AAF]">✓</span> BPOM & Halal Tested
            </span>
            <span class="flex items-center gap-1 font-medium">
              <span class="text-[#D98AAF]">✓</span> Bebas Paraben
            </span>
          </div>
        </div>

        <!-- Trust Badges Under Image -->
        <div class="grid grid-cols-3 gap-3 text-center">
          <div class="bg-[#FFF7FB] p-3.5 rounded-2xl border border-[#F0D5E4]">
            <div class="text-base mb-0.5">🔒</div>
            <div class="text-[11px] font-semibold text-[#29242A]">Kardus Polos</div>
            <div class="text-[10px] text-[#756B72]">Privasi Terjaga 100%</div>
          </div>
          <div class="bg-[#FFF7FB] p-3.5 rounded-2xl border border-[#F0D5E4]">
            <div class="text-base mb-0.5">🧪</div>
            <div class="text-[11px] font-semibold text-[#29242A]">Teruji Klinis</div>
            <div class="text-[10px] text-[#756B72]">Dermatologist Tested</div>
          </div>
          <div class="bg-[#FFF7FB] p-3.5 rounded-2xl border border-[#F0D5E4]">
            <div class="text-base mb-0.5">⚡</div>
            <div class="text-[11px] font-semibold text-[#29242A]">Kirim Hari Ini</div>
            <div class="text-[10px] text-[#756B72]">Order s/d 16.00 WIB</div>
          </div>
        </div>
      </div>

      <!-- Product Information & Action Area (Right 6 cols) -->
      <div class="lg:col-span-6 space-y-6">
        
        <!-- Header Info -->
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-[#D98AAF] bg-[#FFE5F7] px-3 py-1 rounded-full border border-[#F0D5E4]/60">
              {product.badge}
            </span>
            <span class="text-xs text-[#756B72]">{product.volume}</span>
          </div>

          <h1 class="text-3xl sm:text-4xl font-serif font-semibold text-[#29242A] leading-tight mb-2 tracking-tight">
            {product.name}
          </h1>

          <p class="text-xs sm:text-sm text-[#D98AAF] font-medium mb-4">
            {product.tagline}
          </p>

          <!-- Rating & Social Proof -->
          <div class="flex items-center gap-3 text-xs text-[#756B72] pb-4 border-b border-[#F0D5E4]">
            <div class="flex items-center text-amber-400 text-sm">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </div>
            <span class="font-semibold text-[#29242A]">{product.rating}</span>
            <span>•</span>
            <span>({product.reviewCount.toLocaleString('id-ID')} ulasan pelanggan terverifikasi)</span>
          </div>
        </div>

        <!-- Pricing Block -->
        <div class="p-5 rounded-2xl bg-[#FFF7FB] border border-[#F0D5E4] flex items-center justify-between shadow-2xs">
          <div>
            <div class="text-xs text-[#756B72] mb-0.5">Harga Resmi:</div>
            <div class="flex items-baseline gap-3">
              <span class="text-3xl font-serif font-bold text-[#29242A]">{product.price}</span>
              {product.originalPrice && (
                <span class="text-sm text-[#8E828B] line-through">{product.originalPrice}</span>
              )}
            </div>
          </div>

          {product.originalPriceNum && (
            <span class="px-3.5 py-1.5 rounded-full bg-rose-50 text-rose-600 border border-rose-200 text-xs font-bold shadow-2xs">
              Hemat Rp {(product.originalPriceNum - product.priceNum).toLocaleString('id-ID')}
            </span>
          )}
        </div>

        <!-- Stock Status Notification -->
        <div class="flex items-center gap-2 text-xs text-emerald-700 bg-emerald-50/80 px-3.5 py-2 rounded-xl border border-emerald-200">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span class="font-medium">Stok Tersedia di Warehouse Jakarta — Siap Kirim dengan Kemasan Tertutup</span>
        </div>

        <!-- Short Description -->
        <p class="text-sm text-[#756B72] leading-relaxed">
          {product.shortDescription}
        </p>

        <!-- CTAs & Shopping Actions -->
        <div class="space-y-3 pt-2">
          
          <!-- Add to Cart (Direct Cart Drawer Integration) -->
          <button
            type="button"
            data-id={product.id}
            data-name={product.name}
            data-price={product.priceNum}
            data-category={product.category}
            class="add-to-cart-btn w-full py-4 px-6 rounded-full bg-[#29242A] text-white text-sm font-semibold hover:bg-[#D98AAF] transition-all duration-200 shadow-md hover:shadow-lg flex items-center justify-center gap-2 cursor-pointer group">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <span>+ Tambahkan ke Tas Belanja</span>
          </button>

          <!-- Shopee Official & WhatsApp Buttons -->
          <div class="grid sm:grid-cols-2 gap-3">
            <a
              href={product.shopeeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3.5 px-4 rounded-full bg-[#EE4D2D] text-white text-xs font-semibold hover:bg-[#D43D1F] transition-colors flex items-center justify-center gap-2 text-center shadow-xs">
              <span>Beli di Shopee Mall ↗</span>
            </a>

            <a
              href={`https://wa.me/6288980874055?text=${encodeURIComponent(product.waText)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3.5 px-4 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-semibold hover:bg-emerald-100 transition-colors flex items-center justify-center gap-2 text-center">
              <span>Pesan via WhatsApp 💬</span>
            </a>
          </div>
        </div>

        <!-- Guarantee Micro Box -->
        <div class="p-4 rounded-2xl bg-white border border-[#F0D5E4] flex items-start gap-3 text-xs text-[#756B72] shadow-2xs">
          <span class="text-base">📦</span>
          <div>
            <strong class="text-[#29242A] block font-semibold">Jaminan Kemasan Tertutup 100% (Discreet Order):</strong>
            Nama produk tidak akan tercantum pada label pengiriman kurir. Privasi Anda aman sepenuhnya.
          </div>
        </div>
      </div>
    </div>

    <!-- Clinical Performance Strip -->
    <div class="my-16 bg-[#FFF7FB] rounded-3xl p-8 border border-[#F0D5E4] grid sm:grid-cols-3 gap-6 text-center">
      <div class="space-y-1">
        <div class="text-3xl sm:text-4xl font-serif font-bold text-[#D98AAF]">98%</div>
        <div class="text-xs font-semibold text-[#29242A]">Merasakan Kesegaran Alami</div>
        <div class="text-[11px] text-[#756B72]">Bebas rasa perih dan nyaman beraktivitas</div>
      </div>
      <div class="space-y-1 border-y sm:border-y-0 sm:border-x border-[#F0D5E4] py-4 sm:py-0">
        <div class="text-3xl sm:text-4xl font-serif font-bold text-[#D98AAF]">pH 4.0</div>
        <div class="text-xs font-semibold text-[#29242A]">Keseimbangan Mikrobiom</div>
        <div class="text-[11px] text-[#756B72]">Melindungi mantel asam pelindung alami</div>
      </div>
      <div class="space-y-1">
        <div class="text-3xl sm:text-4xl font-serif font-bold text-[#D98AAF]">100%</div>
        <div class="text-xs font-semibold text-[#29242A]">Privasi Pengiriman</div>
        <div class="text-[11px] text-[#756B72]">Kardus polos tanpa label sensitif</div>
      </div>
    </div>

    <!-- Product In-Depth Tabs & Details -->
    <div class="max-w-4xl mx-auto space-y-16 pt-6">
      
      <!-- Full Description -->
      <section>
        <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-[#29242A] mb-4">
          Deskripsi Lengkap
        </h2>
        <div class="prose prose-pink text-[#756B72] text-sm sm:text-base leading-relaxed whitespace-pre-line">
          {product.fullDescription}
        </div>
      </section>

      <!-- Key Benefits Grid -->
      <section>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FFF7FB] border border-[#F0D5E4] text-[11px] font-semibold tracking-wider text-[#D98AAF] uppercase mb-3 shadow-2xs">
          ✦ Khasiat & Keunggulan
        </div>
        <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-[#29242A] mb-8">
          Mengapa {product.name} Istimewa?
        </h2>

        <div class="grid sm:grid-cols-2 gap-6">
          {
            product.benefits.map((b) => (
              <div class="p-6 rounded-3xl bg-white border border-[#F0D5E4] shadow-xs hover:shadow-md transition-shadow">
                <div class="w-8 h-8 rounded-full bg-[#FFE5F7] text-[#D98AAF] flex items-center justify-center font-bold text-xs mb-4">
                  ✓
                </div>
                <h3 class="font-serif font-semibold text-base text-[#29242A] mb-2">
                  {b.title}
                </h3>
                <p class="text-xs sm:text-sm text-[#756B72] leading-relaxed">
                  {b.description}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Usage Steps Guide -->
      <section class="bg-[#FFF7FB] rounded-3xl p-8 sm:p-10 border border-[#F0D5E4]">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-[#F0D5E4] text-[11px] font-semibold tracking-wider text-[#D98AAF] uppercase mb-3 shadow-2xs">
          Panduan Praktis
        </div>
        <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-[#29242A] mb-8">
          Cara Pemakaian yang Dianjurkan
        </h2>

        <div class="grid sm:grid-cols-2 gap-6">
          {
            product.usageSteps.map((s) => (
              <div class="bg-white p-5 rounded-2xl border border-[#F0D5E4] relative shadow-2xs">
                <div class="text-xs font-bold text-[#D98AAF] uppercase tracking-wider mb-2">
                  Langkah 0{s.step}
                </div>
                <h3 class="font-serif font-semibold text-sm text-[#29242A] mb-1.5">
                  {s.title}
                </h3>
                <p class="text-xs text-[#756B72] leading-relaxed">
                  {s.description}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Ingredients & Specifications Table -->
      <section class="grid md:grid-cols-2 gap-8">
        
        <!-- Key Ingredients -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-[#F0D5E4] shadow-xs">
          <h2 class="font-serif font-semibold text-lg text-[#29242A] mb-4">
            🌿 Bahan Aktif Utama
          </h2>
          <div class="space-y-3">
            {
              product.keyIngredients.map((item) => (
                <div class="p-3.5 rounded-xl bg-[#FFF7FB] border border-[#F0D5E4]">
                  <div class="text-xs font-semibold text-[#29242A]">{item.name}</div>
                  <div class="text-[11px] text-[#756B72] mt-0.5">{item.role}</div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Technical Specs -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-[#F0D5E4] shadow-xs">
          <h2 class="font-serif font-semibold text-lg text-[#29242A] mb-4">
            📋 Spesifikasi Produk
          </h2>
          <div class="divide-y divide-[#F5E6EF]">
            {
              product.specs.map((item) => (
                <div class="py-3 flex justify-between text-xs gap-4">
                  <span class="text-[#756B72] font-medium">{item.label}</span>
                  <span class="text-[#29242A] text-right font-semibold">{item.value}</span>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Verified Reviews Section -->
      <section>
        <div class="flex items-center justify-between mb-8">
          <div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FFF7FB] border border-[#F0D5E4] text-[11px] font-semibold tracking-wider text-[#D98AAF] uppercase mb-1 shadow-2xs">
              Ulasan Terverifikasi
            </div>
            <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-[#29242A]">
              Kata Pelanggan & Dokter
            </h2>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-amber-400 text-base">★</span>
            <span class="text-sm font-bold text-[#29242A]">{product.rating} / 5.0</span>
          </div>
        </div>

        <div class="grid sm:grid-cols-3 gap-6">
          {
            sampleReviews.map((rev) => (
              <div class="p-6 rounded-3xl bg-white border border-[#F0D5E4] shadow-xs flex flex-col justify-between">
                <div>
                  <div class="flex text-amber-400 text-xs mb-3">
                    {"★".repeat(rev.rating)}
                  </div>
                  <p class="text-xs text-[#756B72] leading-relaxed mb-4 italic">
                    "{rev.comment}"
                  </p>
                </div>
                <div class="pt-3 border-t border-[#F5E6EF]">
                  <div class="text-xs font-semibold text-[#29242A]">{rev.name}</div>
                  <div class="text-[10px] text-[#D98AAF] font-medium">{rev.role} • {rev.location}</div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Product Specific FAQs -->
      <section>
        <h2 class="text-2xl sm:text-3xl font-serif font-semibold text-[#29242A] mb-6">
          Pertanyaan Umum ({product.name})
        </h2>
        <div class="space-y-4">
          {
            product.faqs.map((faq) => (
              <details class="group bg-white rounded-2xl border border-[#F0D5E4] p-5 [&_summary::-webkit-details-marker]:hidden shadow-2xs">
                <summary class="flex items-center justify-between cursor-pointer font-serif font-semibold text-sm text-[#29242A] group-open:text-[#D98AAF] transition-colors">
                  <span>{faq.question}</span>
                  <span class="ml-4 text-xs shrink-0 transition-transform duration-200 group-open:rotate-180">
                    ▼
                  </span>
                </summary>
                <p class="mt-3 text-xs sm:text-sm text-[#756B72] leading-relaxed pt-3 border-t border-[#F5E6EF]">
                  {faq.answer}
                </p>
              </details>
            ))
          }
        </div>
      </section>

      <!-- OTHER PRODUCTS RECOMMENDATION -->
      <section class="pt-12 border-t border-[#F0D5E4]">
        <div class="flex items-center justify-between mb-8">
          <div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FFF7FB] border border-[#F0D5E4] text-[11px] font-semibold tracking-wider text-[#D98AAF] uppercase mb-1 shadow-2xs">
              Koleksi Lainnya
            </div>
            <h2 class="text-2xl font-serif font-semibold text-[#29242A]">
              Produk Terkait PINCK SMILE
            </h2>
          </div>
          <a
            href="/products"
            class="text-xs font-semibold text-[#D98AAF] hover:text-[#29242A] transition-colors hidden sm:inline-block">
            Lihat Semua Produk →
          </a>
        </div>

        <div class="grid sm:grid-cols-3 gap-6">
          {
            otherProducts.map((p) => (
              <div class="bg-white rounded-3xl p-5 border border-[#F0D5E4] shadow-xs brand-card-hover flex flex-col justify-between group">
                <div>
                  <div class="flex items-center justify-between mb-3">
                    <span class="text-[10px] font-semibold text-[#D98AAF] bg-[#FFF7FB] px-2 py-0.5 rounded-full border border-[#F0D5E4]">
                      {p.category}
                    </span>
                    <span class="text-[10px] text-[#756B72]">{p.volume}</span>
                  </div>

                  <a href={`/products/${p.slug}`} class="block mb-3">
                    <div class={`w-full aspect-[4/3] rounded-2xl bg-gradient-to-br ${p.accentGradient} border border-[#F0D5E4]/60 flex items-center justify-center p-3 overflow-hidden group-hover:scale-[1.02] transition-transform`}>
                      <ProductVisual id={p.id} size="sm" />
                    </div>
                  </a>

                  <h3 class="font-serif font-semibold text-sm text-[#29242A] hover:text-[#D98AAF] transition-colors mb-1 leading-snug">
                    <a href={`/products/${p.slug}`}>{p.name}</a>
                  </h3>
                  
                  <p class="text-[11px] text-[#756B72] line-clamp-2 mb-3">
                    {p.shortDescription}
                  </p>
                </div>

                <div class="pt-3 border-t border-[#F5E6EF] flex items-center justify-between">
                  <span class="text-xs font-bold text-[#D98AAF]">{p.price}</span>
                  <a
                    href={`/products/${p.slug}`}
                    class="text-[11px] font-semibold text-[#29242A] hover:text-[#D98AAF] transition-colors">
                    Lihat Detail →
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- RELATED BLOG ARTICLES -->
      <section class="pt-10 border-t border-[#F0D5E4]">
        <div class="flex items-center justify-between mb-8">
          <div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FFF7FB] border border-[#F0D5E4] text-[11px] font-semibold tracking-wider text-[#D98AAF] uppercase mb-1 shadow-2xs">
              Edukasi & Jurnal
            </div>
            <h2 class="text-2xl font-serif font-semibold text-[#29242A]">
              Panduan Seputar Perawatan Intim
            </h2>
          </div>
          <a
            href="/blog"
            class="text-xs font-semibold text-[#D98AAF] hover:text-[#29242A] transition-colors hidden sm:inline-block">
            Semua Jurnal →
          </a>
        </div>

        <div class="grid sm:grid-cols-3 gap-6">
          {
            relatedArticles.map((post) => (
              <article class="bg-[#FFF7FB] rounded-3xl p-5 border border-[#F0D5E4] brand-card-hover flex flex-col justify-between shadow-2xs">
                <div>
                  <span class="text-[10px] font-semibold uppercase text-[#D98AAF] bg-white px-2 py-0.5 rounded-full border border-[#F0D5E4] mb-2 inline-block">
                    {post.data.category}
                  </span>
                  <h3 class="font-serif font-semibold text-sm text-[#29242A] hover:text-[#D98AAF] transition-colors mb-2 line-clamp-2">
                    <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                  </h3>
                  <p class="text-[11px] text-[#756B72] line-clamp-2 mb-3">
                    {post.data.snippet}
                  </p>
                </div>
                <a
                  href={`/blog/${post.slug}`}
                  class="text-[11px] font-semibold text-[#D98AAF] hover:text-[#29242A] transition-colors flex items-center gap-1">
                  <span>Baca Edukasi</span>
                  <span>→</span>
                </a>
              </article>
            ))
          }
        </div>
      </section>

    </div>
  </Container>
</Layout>
