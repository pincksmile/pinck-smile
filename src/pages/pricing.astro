---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";

const bundles = [
  {
    id: "bundle-essential",
    slug: "gentle-intimate-wash",
    name: "Essential Daily Care",
    tagline: "Perawatan Harian Dasar",
    price: "Rp 149.000",
    priceNum: 149000,
    badge: "Populer",
    popular: false,
    description: "Paket pembersih intim harian untuk menjaga pH dan kesegaran mikrobiom.",
    features: [
      "1x Gentle Intimate Wash (150ml)",
      "Formula pH 4.0 seimbang",
      "Chamomile & Prebiotic complex",
      "Kemasan polos & pengiriman rahasia",
    ],
    buttonText: "Beli Paket Dasar",
  },
  {
    id: "bundle-complete",
    slug: "complete-comfort-set",
    name: "Complete Comfort Set",
    tagline: "Perawatan Lengkap & On-The-Go",
    price: "Rp 259.000",
    priceNum: 259000,
    badge: "Rekomendasi",
    popular: true,
    description: "Kombinasi pembersih harian dan mist penyegar portabel untuk kenyamanan sepanjang hari.",
    features: [
      "1x Gentle Intimate Wash (150ml)",
      "1x Soothing Hydrating Mist (60ml)",
      "Hemat Rp 19.000",
      "Bonus Pouch Kosmetik Sutra Polos",
      "Pengiriman Privasi 100% Terjamin",
    ],
    buttonText: "Pesan Paket Lengkap",
  },
  {
    id: "bundle-ultimate",
    slug: "ultimate-wellness-ritual",
    name: "Ultimate Wellness Ritual",
    tagline: "Koleksi Lengkap & Intimate Device",
    price: "Rp 699.000",
    priceNum: 699000,
    badge: "Best Value",
    popular: false,
    description: "Pengalaman relaksasi dan keintiman maksimal dengan rangkaian perawatan menyeluruh.",
    features: [
      "1x Gentle Intimate Wash (150ml)",
      "1x Soothing Hydrating Mist (60ml)",
      "1x Aura Intimate Device (Medical Silicone)",
      "Magnetic USB Charger & Storage Bag",
      "Garansi Resmi 1 Tahun PINCK SMILE",
      "Gratis Ongkir & Prioritas Pengiriman",
    ],
    buttonText: "Pilih Ultimate Set",
  },
];
---

<Layout 
  title="Daftar Harga & Paket Produk - PINCK SMILE Intimate Wellness"
  description="Daftar harga resmi produk dan paket hemat PINCK SMILE Female Intimate Wellness. 100% original, body-safe, pH seimbang, dan garansi pengiriman tertutup.">
  <Container class="py-16">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FFF7FB] border border-[#F0D5E4] text-xs font-semibold tracking-wider text-[#D98AAF] uppercase mb-3">
        Katalog & Paket Hemat
      </div>
      <h1 class="text-4xl sm:text-5xl font-serif font-semibold text-[#29242A]">
        Pilihan Perawatan Sesuai Kebutuhan Anda
      </h1>
      <p class="text-base text-[#756B72] mt-4 leading-relaxed">
        Harga transparan tanpa biaya tersembunyi. Semua pesanan dikirim dengan kemasan polos rahasia (discreet).
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mx-auto max-w-6xl">
      {
        bundles.map((bundle) => (
          <div class={`rounded-3xl p-8 border flex flex-col justify-between relative brand-card-hover ${bundle.popular ? 'bg-[#FFF7FB] border-[#D98AAF] shadow-md' : 'bg-white border-[#F0D5E4]'}`}>
            {bundle.popular && (
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[#D98AAF] text-white text-[11px] font-semibold tracking-wider uppercase px-3 py-1 rounded-full shadow-xs">
                Paling Diminati
              </div>
            )}

            <div>
              <span class="text-xs font-semibold text-[#D98AAF] block uppercase tracking-wider mb-1">
                {bundle.badge}
              </span>
              <h2 class="text-2xl font-serif font-semibold text-[#29242A] hover:text-[#D98AAF] transition-colors">
                <a href={`/products/${bundle.slug}`}>
                  {bundle.name}
                </a>
              </h2>
              <p class="text-xs text-[#756B72] mt-1 mb-4">
                {bundle.tagline}
              </p>

              <div class="text-3xl font-bold text-[#29242A] mb-4">
                {bundle.price}
              </div>

              <p class="text-xs text-[#756B72] leading-relaxed mb-6">
                {bundle.description}
              </p>

              <ul class="space-y-3 pt-6 border-t border-[#F0D5E4] mb-8">
                {bundle.features.map((feature) => (
                  <li class="flex items-start gap-2.5 text-xs text-[#29242A]/90">
                    <span class="w-4 h-4 rounded-full bg-[#FFE5F7] text-[#D98AAF] flex items-center justify-center shrink-0 mt-0.5">
                      ✓
                    </span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="space-y-2">
              <button
                type="button"
                data-id={bundle.id}
                data-name={bundle.name}
                data-price={bundle.priceNum}
                class={`add-to-cart-btn w-full block text-center py-3.5 rounded-full text-xs font-semibold transition-all duration-200 cursor-pointer ${bundle.popular ? 'bg-[#D98AAF] text-white hover:bg-[#C6759B] shadow-sm' : 'bg-[#29242A] text-white hover:bg-[#D98AAF]'}`}>
                {bundle.buttonText}
              </button>

              <a
                href={`/products/${bundle.slug}`}
                class="w-full block text-center py-2 text-[11px] font-semibold text-[#756B72] hover:text-[#D98AAF] transition-colors">
                Lihat Spesifikasi & Panduan Detail →
              </a>
            </div>
          </div>
        ))
      }
    </div>
    <!-- Marketplace & Discreet Packaging Guarantee Info -->
    <div class="mt-16 bg-[#FFF7FB] rounded-3xl p-8 border border-[#F0D5E4] flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <div class="space-y-1">
        <h3 class="text-base font-serif font-semibold text-[#29242A]">
          Belanja Lebih Nyaman di Shopee Mall Resmi
        </h3>
        <p class="text-xs text-[#756B72] max-w-xl">
          Nikmati promo Gratis Ongkir Ekstra, opsi COD, serta voucher diskon toko di Official Store Shopee PINCK SMILE. Privasi paket 100% terjaga.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3 shrink-0">
        <a
          href="https://s.shopee.co.id/9zx2C9Pfba"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#EE4D2D] text-white text-xs font-semibold hover:bg-[#D43D1F] transition-colors shadow-sm">
          <span>Kunjungi Shopee Official</span>
          <span class="text-xs">↗</span>
        </a>
        <a
          href="https://wa.me/6288980874055?text=Halo%20PINCK%20SMILE%2C%20saya%20tertarik%20dengan%20paket%20hemat%20perawatan%20intim."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white text-[#29242A] border border-[#F0D5E4] text-xs font-semibold hover:bg-[#FFE5F7] transition-colors">
          <span>Tanya via WhatsApp</span>
        </a>
      </div>
    </div>
  </Container>
</Layout>
